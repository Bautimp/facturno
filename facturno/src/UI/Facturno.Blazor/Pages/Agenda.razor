@page "/agenda"
@attribute [Authorize]

<div class="facturno-card" style="position: relative;">
    <LoadingOverlay IsLoading="IsLoading" Text="Cargando agenda de turnos..." />
    @if (PopoverTurnoId != null)
    {
        <div class="popover-backdrop" @onclick="CerrarPopover"></div>
    }
    <div class="card-header-custom align-items-center">
        <div>
            <h3 class="m-0 font-bold">Agenda y Turnos Médicos</h3>
            <p class="text-muted m-0 small">Gestión clínica y control asistencial de citas</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <!-- Switch Selector de 3 Vistas: Día | Semana | Mes -->
            <div class="btn-group switcher-vistas" role="group">
                <button type="button" class="btn btn-sm @(VistaActual == TipoVistaAgenda.Dia ? "btn-primary-custom" : "btn-outline-secondary")" @onclick="() => CambiarVista(TipoVistaAgenda.Dia)">
                    Día
                </button>
                <button type="button" class="btn btn-sm @(VistaActual == TipoVistaAgenda.Semana ? "btn-primary-custom" : "btn-outline-secondary")" @onclick="() => CambiarVista(TipoVistaAgenda.Semana)">
                    Semana
                </button>
                <button type="button" class="btn btn-sm @(VistaActual == TipoVistaAgenda.Mes ? "btn-primary-custom" : "btn-outline-secondary")" @onclick="() => CambiarVista(TipoVistaAgenda.Mes)">
                    Mes
                </button>
            </div>

            <button class="btn btn-primary-custom btn-sm" @onclick="AbrirModalNuevoTurno">
                + Nuevo Turno
            </button>

            <button class="btn btn-outline-primary btn-sm" @onclick="AbrirModalTurnoRecurrente">
                🔄 Turno Recurrente
            </button>
        </div>
    </div>

    <!-- Filtros de Fecha y Profesional -->
    <div class="row g-3 mb-4 align-items-end">
        @if (!EsProfesionalLogueado)
        {
            <div class="col-md-5">
                <label class="form-label font-semibold small">Profesional Médico</label>
                <select class="form-select" @onchange="OnProfesionalChanged">
                    @foreach (var prof in ListaProfesionales)
                    {
                        var nombre = prof.Usuario?.Persona != null ? $"{prof.Usuario.Persona.Nombre} {prof.Usuario.Persona.Apellido} ({prof.Especialidad})" : "Profesional";
                        <option value="@prof.IdProfesional" selected="@(prof.IdProfesional == SelectedProfesionalId)">@nombre</option>
                    }
                </select>
            </div>
        }
        else
        {
            <div class="col-md-5">
                <label class="form-label font-semibold small">Agenda de</label>
                <input type="text" class="form-control bg-light" value="@GetNombreProfesionalSeleccionado()" readonly />
            </div>
        }

        <div class="col-md-4">
            <label class="form-label font-semibold small">Fecha Referencia</label>
            <input type="date" class="form-control" value="@SelectedFecha.ToString("yyyy-MM-dd")" @onchange="OnFechaChanged" />
        </div>

        <div class="col-md-3">
            <button class="btn btn-secondary-custom w-100" @onclick="CargarTurnos">
                Buscar Turnos
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(MensajeAlerta))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @MensajeAlerta
            <button type="button" class="btn-close" @onclick="() => MensajeAlerta = null"></button>
        </div>
    }

    @if (VistaActual == TipoVistaAgenda.Dia)
    {
        <!-- VISTA DÍA (Predeterminada) -->
        <div class="grid-turnos">
            @foreach (var slot in TimeSlots)
            {
                var turnoSlot = ListaTurnos.FirstOrDefault(t => t.Hora == slot);

                <div class="slot-hora" style="position: relative; overflow: visible; z-index: @(turnoSlot != null && PopoverTurnoId == turnoSlot.IdTurno ? "50" : "1");">
                    <div class="slot-time">
                        @slot.ToString("HH:mm") hs
                    </div>

                    <div class="slot-body">
                        @if (turnoSlot != null)
                        {
                            <div class="turno-box-container" style="position: relative;">
                                <div class="turno-box @GetBorderAccentClass(turnoSlot.Estado) @(PopoverTurnoId == turnoSlot.IdTurno ? "active-popover" : "")" @onclick="() => TogglePopoverEstado(turnoSlot.IdTurno)">
                                    <div class="d-flex align-items-center justify-content-between w-100 flex-wrap gap-2">
                                        <div class="d-flex align-items-center flex-wrap gap-1">
                                            <span class="badge-estado @GetBadgeClass(turnoSlot.Estado)">@GetEstadoTextoConIcono(turnoSlot.Estado)</span>
                                            @if (turnoSlot.Modalidad == ModalidadTurno.Online)
                                            {
                                                <span class="badge badge-modalidad-online ms-1" title="Consulta médica online por videollamada">
                                                    📹 Online
                                                </span>
                                            }
                                            <strong class="ms-2">@GetNombrePaciente(turnoSlot.IdPaciente)</strong>
                                            @if (!string.IsNullOrWhiteSpace(turnoSlot.Observacion))
                                            {
                                                <span class="text-muted ms-1 italic small">(@turnoSlot.Observacion)</span>
                                            }
                                        </div>

                                        <div class="d-flex align-items-center gap-2" @onclick:stopPropagation="true">
                                            @if (turnoSlot.Modalidad == ModalidadTurno.Online)
                                            {
                                                @if (!string.IsNullOrWhiteSpace(turnoSlot.EnlaceReunion))
                                                {
                                                    <a href="@turnoSlot.EnlaceReunion" target="_blank" class="btn btn-sm btn-join-videocall" title="Unirse a la videollamada de la consulta">
                                                        <span class="video-icon-pulse">●</span> 📹 Unirse a Videollamada
                                                    </a>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 disabled" disabled title="Sin enlace de videollamada configurado" style="cursor: not-allowed; opacity: 0.65;">
                                                        📹 Sin enlace
                                                    </button>
                                                }
                                            }
                                            @if (turnoSlot.Estado == EstadoTurno.Completo)
                                            {
                                                <a href="@GetPdfUrl(turnoSlot.IdTurno)" target="_blank" class="btn btn-sm btn-outline-success">
                                                    Comprobante PDF
                                                </a>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => TogglePopoverEstado(turnoSlot.IdTurno)">
                                                Estado &blacktriangledown;
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Popover Flotante a la Derecha -->
                                @if (PopoverTurnoId == turnoSlot.IdTurno)
                                {
                                    <div class="popover-inline-estados shadow">
                                        @if (turnoSlot.Modalidad == ModalidadTurno.Online)
                                        {
                                            <div class="p-2 mb-2 bg-light rounded border text-start">
                                                <div class="small font-bold text-primary mb-1">📹 Consulta Online</div>
                                                @if (!string.IsNullOrWhiteSpace(turnoSlot.EnlaceReunion))
                                                {
                                                    <a href="@turnoSlot.EnlaceReunion" target="_blank" class="btn btn-xs btn-primary w-100 text-truncate" title="@turnoSlot.EnlaceReunion" @onclick:stopPropagation="true">
                                                        Abrir Videollamada
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle w-100 py-1 d-block text-center" style="cursor: not-allowed;">
                                                        Sin enlace configurado
                                                    </span>
                                                }
                                            </div>
                                        }
                                        <div class="popover-header-small">Cambiar estado:</div>
                                        <div class="d-flex flex-column gap-1">
                                            <button type="button" class="btn-state-item btn-state-activo" @onclick:stopPropagation="true" @onclick="() => CambiarEstadoDirecto(turnoSlot, EstadoTurno.Activo)">
                                                <span class="state-icon-circle bg-activo">✓</span>
                                                <span>Activo</span>
                                            </button>
                                            <button type="button" class="btn-state-item btn-state-completo" @onclick:stopPropagation="true" @onclick="() => CambiarEstadoDirecto(turnoSlot, EstadoTurno.Completo)">
                                                <span class="state-icon-circle bg-completo">✓</span>
                                                <span>Completo</span>
                                            </button>
                                            <button type="button" class="btn-state-item btn-state-falta" @onclick:stopPropagation="true" @onclick="() => CambiarEstadoDirecto(turnoSlot, EstadoTurno.Falta)">
                                                <span class="state-icon-circle bg-falta">⚠</span>
                                                <span>Falta</span>
                                            </button>
                                            <button type="button" class="btn-state-item btn-state-cancelado" @onclick:stopPropagation="true" @onclick="() => CambiarEstadoDirecto(turnoSlot, EstadoTurno.Cancelado)">
                                                <span class="state-icon-circle bg-cancelado">✕</span>
                                                <span>Cancelado</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-between w-100">
                                <span class="text-muted italic small">Disponible</span>
                                <button class="btn btn-sm btn-light border" @onclick="() => AgendarSlotEspecifico(slot)">
                                    + Agendar
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (VistaActual == TipoVistaAgenda.Semana)
    {
        <!-- VISTA SEMANA -->
        <div class="vista-semana-container">
            <div class="row g-2">
                @foreach (var dia in DiasSemana)
                {
                    var turnosDelDia = TurnosPorFecha.ContainsKey(dia) ? TurnosPorFecha[dia] : new List<Turno>();
                    var esHoy = dia == DateOnly.FromDateTime(DateTime.Today);
                    var colIndex = DiasSemana.IndexOf(dia);
                    var isRightEdge = colIndex >= 4;

                    <div class="col-md-4 col-lg">
                        <div class="card card-dia-semana @(esHoy ? "border-primary" : "")">
                            <div class="card-header p-2 d-flex align-items-center justify-content-between @(esHoy ? "bg-primary text-white font-bold" : "bg-light font-semibold")">
                                <div>
                                    <div>@dia.ToString("dddd", new System.Globalization.CultureInfo("es-ES")).ToUpper()</div>
                                    <div class="small">@dia.ToString("dd/MM/yyyy")</div>
                                </div>
                                <button class="btn btn-xs @(esHoy ? "btn-light text-primary" : "btn-outline-primary")" @onclick="() => AbrirModalNuevoTurnoConFecha(dia)" title="Agregar turno este día">
                                    + Turno
                                </button>
                            </div>
                            <div class="card-body p-2 min-h-200">
                                @if (turnosDelDia.Any())
                                {
                                    @foreach (var turno in turnosDelDia)
                                    {
                                        <div class="turno-box-semana mb-2 p-2 border rounded @GetBorderAccentClass(turno.Estado) @(PopoverTurnoId == turno.IdTurno ? "active-popover" : "")" style="position: relative;" @onclick="() => TogglePopoverEstado(turno.IdTurno)">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div class="d-flex align-items-center gap-1">
                                                    <span class="badge-estado @GetBadgeClass(turno.Estado)">@GetEstadoTextoConIcono(turno.Estado)</span>
                                                    @if (turno.Modalidad == ModalidadTurno.Online)
                                                    {
                                                        <span class="badge badge-modalidad-online-sm" title="Turno Online (Videollamada)">📹 Online</span>
                                                    }
                                                </div>
                                                <small class="text-muted font-semibold">@turno.Hora.ToString("HH:mm") hs</small>
                                            </div>
                                            <div class="small font-bold">@GetNombrePaciente(turno.IdPaciente)</div>
                                            @if (turno.Modalidad == ModalidadTurno.Online)
                                            {
                                                <div class="mt-1" @onclick:stopPropagation="true">
                                                    @if (!string.IsNullOrWhiteSpace(turno.EnlaceReunion))
                                                    {
                                                        <a href="@turno.EnlaceReunion" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 w-100 text-center" style="font-size: 0.72rem;">
                                                            📹 Unirse a llamada
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 w-100 text-center disabled" disabled style="font-size: 0.72rem; cursor: not-allowed; opacity: 0.65;" title="Sin enlace de videollamada asignado">
                                                            📹 Sin enlace
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            
                                            <!-- Popover Flotante a la Derecha -->
                                            @if (PopoverTurnoId == turno.IdTurno)
                                            {
                                                <div class="popover-inline-estados shadow @(isRightEdge ? "popover-align-left" : "")">
                                                    <div class="popover-header-small mb-1">Cambiar estado:</div>
                                                    <div class="d-flex flex-column gap-1">
                                                        <button type="button" class="btn-state-item btn-state-activo" @onclick:stopPropagation="true" @onclick="() => CambiarEstadoDirecto(turno, EstadoTurno.Activo)">
                                                            <span class="state-icon-circle bg-activo">✓</span>
                                                            <span>Activo</span>
                                                        </button>
                                                        <button type="button" class="btn-state-item btn-state-completo" @onclick:stopPropagation="true" @onclick="() => CambiarEstadoDirecto(turno, EstadoTurno.Completo)">
                                                            <span class="state-icon-circle bg-completo">✓</span>
                                                            <span>Completo</span>
                                                        </button>
                                                        <button type="button" class="btn-state-item btn-state-falta" @onclick:stopPropagation="true" @onclick="() => CambiarEstadoDirecto(turno, EstadoTurno.Falta)">
                                                            <span class="state-icon-circle bg-falta">⚠</span>
                                                            <span>Falta</span>
                                                        </button>
                                                        <button type="button" class="btn-state-item btn-state-cancelado" @onclick:stopPropagation="true" @onclick="() => CambiarEstadoDirecto(turno, EstadoTurno.Cancelado)">
                                                            <span class="state-icon-circle bg-cancelado">✕</span>
                                                            <span>Cancelado</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted small text-center py-3">Sin turnos</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (VistaActual == TipoVistaAgenda.Mes)
    {
        <!-- VISTA MES (Ordenado de Lunes a Domingo) -->
        <div class="vista-mes-container">
            <h5 class="font-bold text-center mb-3">@SelectedFecha.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-ES")).ToUpper()</h5>
            
            <!-- Cabecera de Días de la Semana -->
            <div class="calendar-grid-header mb-2">
                <div class="calendar-day-name font-bold text-center">LUNES</div>
                <div class="calendar-day-name font-bold text-center">MARTES</div>
                <div class="calendar-day-name font-bold text-center">MIÉRCOLES</div>
                <div class="calendar-day-name font-bold text-center">JUEVES</div>
                <div class="calendar-day-name font-bold text-center">VIERNES</div>
                <div class="calendar-day-name font-bold text-center text-secondary">SÁBADO</div>
                <div class="calendar-day-name font-bold text-center text-secondary">DOMINGO</div>
            </div>

            <!-- Grilla del Calendario -->
            <div class="calendar-grid-body">
                @for (int i = 0; i < OffsetPrimerDiaMes; i++)
                {
                    <div class="card card-dia-mes card-dia-empty p-2"></div>
                }

                @foreach (var dia in DiasMes)
                {
                    var turnosDelDia = TurnosPorFecha.ContainsKey(dia) ? TurnosPorFecha[dia] : new List<Turno>();
                    var esHoy = dia == DateOnly.FromDateTime(DateTime.Today);
                    var dayCol = ((int)dia.DayOfWeek + 6) % 7;
                    var isRightEdgeMonth = dayCol >= 4;

                    <div class="card card-dia-mes p-2 @(esHoy ? "border-primary bg-light-blue" : "")" style="position: relative;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="font-bold @(esHoy ? "text-primary" : "")">@dia.Day</span>
                            <div class="d-flex align-items-center gap-1">
                                @if (turnosDelDia.Any())
                                {
                                    <span class="badge bg-primary" style="font-size: 0.65rem;">@turnosDelDia.Count</span>
                                }
                                <button class="btn btn-xs btn-outline-primary py-0 px-1" style="font-size: 0.7rem; line-height: 1;" @onclick="() => AbrirModalNuevoTurnoConFecha(dia)" title="Agregar turno este día">
                                    +
                                </button>
                            </div>
                        </div>
                        @if (turnosDelDia.Any())
                        {
                            <div class="list-turnos-mes">
                                @foreach (var turno in turnosDelDia.Take(3))
                                {
                                    <div class="position-relative mb-1">
                                        <div class="small-turno-tag @GetBadgeClass(turno.Estado) @GetBorderAccentClass(turno.Estado)" @onclick="() => TogglePopoverEstado(turno.IdTurno)">
                                            @turno.Hora.ToString("HH:mm") @(turno.Modalidad == ModalidadTurno.Online ? "📹 " : "")- @GetNombrePaciente(turno.IdPaciente)
                                        </div>

                                        @if (PopoverTurnoId == turno.IdTurno)
                                        {
                                            <div class="popover-inline-estados shadow @(isRightEdgeMonth ? "popover-align-left" : "")">
                                                <div class="popover-header-small mb-1">Estado:</div>
                                                <div class="d-flex flex-column gap-1">
                                                    <button type="button" class="btn-state-item btn-state-activo" @onclick:stopPropagation="true" @onclick="() => CambiarEstadoDirecto(turno, EstadoTurno.Activo)">
                                                        <span class="state-icon-circle bg-activo">✓</span>
                                                        <span>Activo</span>
                                                    </button>
                                                    <button type="button" class="btn-state-item btn-state-completo" @onclick:stopPropagation="true" @onclick="() => CambiarEstadoDirecto(turno, EstadoTurno.Completo)">
                                                        <span class="state-icon-circle bg-completo">✓</span>
                                                        <span>Completo</span>
                                                    </button>
                                                    <button type="button" class="btn-state-item btn-state-falta" @onclick:stopPropagation="true" @onclick="() => CambiarEstadoDirecto(turno, EstadoTurno.Falta)">
                                                        <span class="state-icon-circle bg-falta">⚠</span>
                                                        <span>Falta</span>
                                                    </button>
                                                    <button type="button" class="btn-state-item btn-state-cancelado" @onclick:stopPropagation="true" @onclick="() => CambiarEstadoDirecto(turno, EstadoTurno.Cancelado)">
                                                        <span class="state-icon-circle bg-cancelado">✕</span>
                                                        <span>Cancelado</span>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (turnosDelDia.Count > 3)
                                {
                                    <div class="text-muted text-center micro-text">+@(turnosDelDia.Count - 3) más</div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted micro-text py-1"></div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Modal Nuevo Turno -->
@if (MostrarModalNuevo)
{
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <h4 class="mb-3 font-bold">Nuevo Turno Médico</h4>
            <EditForm Model="nuevoTurnoDto" OnValidSubmit="GuardarNuevoTurno">
                <div class="mb-3">
                    <label class="form-label font-semibold">Paciente</label>
                    <select class="form-select" @bind="nuevoTurnoDto.IdPaciente">
                        <option value="0">Seleccionar Paciente...</option>
                        @foreach (var pac in ListaPacientes)
                        {
                            var nomPac = pac.Persona != null ? $"{pac.Persona.Nombre} {pac.Persona.Apellido} (DNI {pac.NumDocumento})" : $"Paciente #{pac.IdPaciente}";
                            <option value="@pac.IdPaciente">@nomPac</option>
                        }
                    </select>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Fecha</label>
                        <input type="date" class="form-control" value="@nuevoTurnoDto.Fecha.ToString("yyyy-MM-dd")" @onchange="(e) => nuevoTurnoDto.Fecha = DateOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Hora</label>
                        <input type="time" class="form-control" value="@nuevoTurnoDto.Hora.ToString("HH:mm")" @onchange="(e) => nuevoTurnoDto.Hora = TimeOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label font-semibold">Modalidad de Atención</label>
                    <div class="d-flex gap-2">
                        <div class="modal-check-btn @(nuevoTurnoDto.Modalidad == ModalidadTurno.Presencial ? "active" : "")" @onclick="() => nuevoTurnoDto.Modalidad = ModalidadTurno.Presencial">
                            <input class="form-check-input mt-0" type="radio" name="modalidadNuevo" id="modNuevoPresencial" 
                                   checked="@(nuevoTurnoDto.Modalidad == ModalidadTurno.Presencial)"
                                   @onchange="() => nuevoTurnoDto.Modalidad = ModalidadTurno.Presencial" />
                            <label class="form-check-label mb-0 cursor-pointer" for="modNuevoPresencial">
                                🏥 Presencial (Consultorio)
                            </label>
                        </div>
                        <div class="modal-check-btn @(nuevoTurnoDto.Modalidad == ModalidadTurno.Online ? "active" : "")" @onclick="() => nuevoTurnoDto.Modalidad = ModalidadTurno.Online">
                            <input class="form-check-input mt-0" type="radio" name="modalidadNuevo" id="modNuevoOnline" 
                                   checked="@(nuevoTurnoDto.Modalidad == ModalidadTurno.Online)"
                                   @onchange="() => nuevoTurnoDto.Modalidad = ModalidadTurno.Online" />
                            <label class="form-check-label mb-0 cursor-pointer" for="modNuevoOnline">
                                📹 Online (Videollamada)
                            </label>
                        </div>
                    </div>
                </div>

                @if (nuevoTurnoDto.Modalidad == ModalidadTurno.Online)
                {
                    <div class="mb-3 p-3 rounded border online-config-box">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label font-semibold mb-0">Enlace de Videollamada</label>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Telemedicina</span>
                        </div>
                        <input type="url" class="form-control" @bind="nuevoTurnoDto.EnlaceReunion" 
                               placeholder="https://meet.google.com/... o https://zoom.us/... (opcional)" />
                        <div class="form-text small text-muted mt-1">
                            💡 Opcional. Si no ingresas un enlace, el turno se registrará sin enlace y el botón de acceso permanecerá inhabilitado.
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label font-semibold">Observaciones</label>
                    <textarea class="form-control" rows="2" @bind="nuevoTurnoDto.Observacion" placeholder="Motivo de consulta..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary-custom" @onclick="() => MostrarModalNuevo = false">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">Agendar Turno</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal Turno Recurrente -->
@if (MostrarModalRecurrente)
{
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <h4 class="mb-3 font-bold">Agendar Turnos Recurrentes</h4>
            <EditForm Model="recurrenteDto" OnValidSubmit="GuardarTurnosRecurrentes">
                <div class="mb-3">
                    <label class="form-label font-semibold">Paciente</label>
                    <select class="form-select" @bind="recurrenteDto.IdPaciente">
                        <option value="0">Seleccionar Paciente...</option>
                        @foreach (var pac in ListaPacientes)
                        {
                            var nomPac = pac.Persona != null ? $"{pac.Persona.Nombre} {pac.Persona.Apellido}" : $"Paciente #{pac.IdPaciente}";
                            <option value="@pac.IdPaciente">@nomPac</option>
                        }
                    </select>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Día de la Semana</label>
                        <select class="form-select" @bind="recurrenteDto.DiaSemana">
                            <option value="@DayOfWeek.Monday">Lunes</option>
                            <option value="@DayOfWeek.Tuesday">Martes</option>
                            <option value="@DayOfWeek.Wednesday">Miércoles</option>
                            <option value="@DayOfWeek.Thursday">Jueves</option>
                            <option value="@DayOfWeek.Friday">Viernes</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Hora</label>
                        <input type="time" class="form-control" value="@recurrenteDto.Hora.ToString("HH:mm")" @onchange="(e) => recurrenteDto.Hora = TimeOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Fecha Inicio</label>
                        <input type="date" class="form-control" value="@recurrenteDto.FechaInicio.ToString("yyyy-MM-dd")" @onchange="(e) => recurrenteDto.FechaInicio = DateOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Fecha Fin</label>
                        <input type="date" class="form-control" value="@recurrenteDto.FechaFin.ToString("yyyy-MM-dd")" @onchange="(e) => recurrenteDto.FechaFin = DateOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label font-semibold">Modalidad de Atención</label>
                    <div class="d-flex gap-2">
                        <div class="modal-check-btn @(recurrenteDto.Modalidad == ModalidadTurno.Presencial ? "active" : "")" @onclick="() => recurrenteDto.Modalidad = ModalidadTurno.Presencial">
                            <input class="form-check-input mt-0" type="radio" name="modalidadRecurrente" id="modRecPresencial" 
                                   checked="@(recurrenteDto.Modalidad == ModalidadTurno.Presencial)"
                                   @onchange="() => recurrenteDto.Modalidad = ModalidadTurno.Presencial" />
                            <label class="form-check-label mb-0 cursor-pointer" for="modRecPresencial">
                                🏥 Presencial (Consultorio)
                            </label>
                        </div>
                        <div class="modal-check-btn @(recurrenteDto.Modalidad == ModalidadTurno.Online ? "active" : "")" @onclick="() => recurrenteDto.Modalidad = ModalidadTurno.Online">
                            <input class="form-check-input mt-0" type="radio" name="modalidadRecurrente" id="modRecOnline" 
                                   checked="@(recurrenteDto.Modalidad == ModalidadTurno.Online)"
                                   @onchange="() => recurrenteDto.Modalidad = ModalidadTurno.Online" />
                            <label class="form-check-label mb-0 cursor-pointer" for="modRecOnline">
                                📹 Online (Videollamada)
                            </label>
                        </div>
                    </div>
                </div>

                @if (recurrenteDto.Modalidad == ModalidadTurno.Online)
                {
                    <div class="mb-3 p-3 rounded border online-config-box">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label font-semibold mb-0">Enlace de Videollamada</label>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Telemedicina</span>
                        </div>
                        <input type="url" class="form-control" @bind="recurrenteDto.EnlaceReunion" 
                               placeholder="https://meet.google.com/... o https://zoom.us/... (opcional)" />
                        <div class="form-text small text-muted mt-1">
                            💡 Opcional. Si no ingresas un enlace, el turno se registrará sin enlace y el botón de acceso permanecerá inhabilitado.
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary-custom" @onclick="() => MostrarModalRecurrente = false">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">Generar Serie de Turnos</button>
                </div>
            </EditForm>
        </div>
    </div>
}
