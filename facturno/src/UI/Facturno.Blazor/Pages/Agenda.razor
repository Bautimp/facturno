@page "/agenda"
@attribute [Authorize]

<div class="facturno-card" style="position: relative;">
    <LoadingOverlay IsLoading="IsLoading" Text="Cargando agenda de turnos..." />
    @if (PopoverTurnoId != null)
    {
        <div class="popover-backdrop" @onclick="CerrarPopover"></div>
    }
    <div class="card-header-custom align-items-center">
        <div>
            <h3 class="m-0 font-bold">Agenda y Turnos Médicos</h3>
            <p class="text-muted m-0 small">Gestión clínica y control asistencial de citas</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary-custom btn-sm" @onclick="AbrirModalNuevoTurno">
                + Nuevo Turno
            </button>

            <button class="btn btn-outline-primary btn-sm" @onclick="AbrirModalTurnoRecurrente">
                🔄 Turno Recurrente
            </button>
        </div>
    </div>

    <!-- Filtros de Fecha y Profesional -->
    <div class="row g-3 mb-3 align-items-end">
        @if (!EsProfesionalLogueado)
        {
            <div class="col-md-5">
                <label class="form-label font-semibold small">Profesional Médico</label>
                <select class="form-select" @onchange="OnProfesionalChanged">
                    @foreach (var prof in ListaProfesionales)
                    {
                        var nombre = prof.Usuario?.Persona != null ? $"{prof.Usuario.Persona.Nombre} {prof.Usuario.Persona.Apellido} ({prof.Especialidad})" : "Profesional";
                        <option value="@prof.IdProfesional" selected="@(prof.IdProfesional == SelectedProfesionalId)">@nombre</option>
                    }
                </select>
            </div>
        }
        else
        {
            <div class="col-md-5">
                <label class="form-label font-semibold small">Agenda de</label>
                <input type="text" class="form-control bg-light" value="@GetNombreProfesionalSeleccionado()" readonly />
            </div>
        }

        <div class="col-md-4">
            <label class="form-label font-semibold small">Fecha Referencia</label>
            <input type="date" class="form-control" value="@SelectedFecha.ToString("yyyy-MM-dd")" @onchange="OnFechaChanged" />
        </div>

        <div class="col-md-3">
            <button class="btn btn-secondary-custom w-100" @onclick="CargarTurnos">
                Buscar Turnos
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(MensajeAlerta))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @MensajeAlerta
            <button type="button" class="btn-close" @onclick="() => MensajeAlerta = null"></button>
        </div>
    }

    <!-- Barra Superior de Navegación de Semanas con un solo click -->
    <div class="semana-nav-bar d-flex justify-content-between align-items-center mb-3 p-2 px-3 bg-white rounded border shadow-sm flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1 font-semibold btn-nav-semana" @onclick="SemanaAnterior" title="Semana anterior">
                <span class="nav-arrow">&larr;</span> Semana Anterior
            </button>
            <button class="btn btn-sm btn-outline-secondary font-semibold" @onclick="IrSemanaActual" title="Volver a la semana actual">
                Hoy
            </button>
            <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1 font-semibold btn-nav-semana" @onclick="SemanaSiguiente" title="Semana siguiente">
                Semana Siguiente <span class="nav-arrow">&rarr;</span>
            </button>
        </div>

        <div class="text-center d-flex align-items-center gap-2">
            <span style="font-size: 1.25rem;">📅</span>
            <h5 class="m-0 font-bold text-primary semana-rango-titulo">
                @GetTextoRangoSemana()
            </h5>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 font-semibold">
                Total citas semana: @GetTotalTurnosSemana()
            </span>
        </div>
    </div>

    <!-- VISTA SEMANAL (6 Columnas: Lunes a Viernes + Sábado y Domingo compartiendo espacio vertical) -->
    <div class="semana-grid-container">
        @for (int i = 0; i < Math.Min(5, DiasSemana.Count); i++)
        {
            var dia = DiasSemana[i];
            var turnosDelDia = TurnosPorFecha.ContainsKey(dia) ? TurnosPorFecha[dia] : new List<Turno>();
            var esHoy = dia == DateOnly.FromDateTime(DateTime.Today);
            var isRightEdge = i >= 3;
            var diaNombre = dia.ToString("dddd", new System.Globalization.CultureInfo("es-ES")).ToUpper();

            <div class="col-dia-semana">
                <div class="card card-dia-semana @(esHoy ? "border-primary shadow-sm" : "")">
                    <div class="card-header-semana p-2 d-flex align-items-center justify-content-between @(esHoy ? "bg-primary text-white" : "bg-light")">
                        <div>
                            <div class="font-bold dia-titulo">
                                @diaNombre
                                @if (esHoy)
                                {
                                    <span class="badge bg-white text-primary ms-1" style="font-size: 0.65rem;">HOY</span>
                                }
                            </div>
                            <div class="small opacity-75">@dia.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            @if (turnosDelDia.Any())
                            {
                                <span class="badge @(esHoy ? "bg-white text-primary" : "bg-primary") badge-pill">@turnosDelDia.Count</span>
                            }
                            <button class="btn btn-xs @(esHoy ? "btn-light text-primary" : "btn-outline-primary")" @onclick="() => AbrirModalNuevoTurnoConFecha(dia)" title="Agregar turno este día">
                                + Turno
                            </button>
                        </div>
                    </div>
                    <div class="card-body-semana p-2">
                        @if (turnosDelDia.Any())
                        {
                            @foreach (var turno in turnosDelDia)
                            {
                                @RenderTurnoCard(turno, isRightEdge)
                            }
                        }
                        else
                        {
                            <div class="text-muted small text-center py-4 empty-turnos-slot">
                                <div>Sin turnos agendados</div>
                                <button class="btn btn-xs btn-outline-primary mt-2" @onclick="() => AbrirModalNuevoTurnoConFecha(dia)">
                                    + Agendar cita
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Columna 6: Sábado y Domingo compartiendo un único espacio vertical (uno abajo del otro) -->
        @if (DiasSemana.Count >= 7)
        {
            var sabado = DiasSemana[5];
            var domingo = DiasSemana[6];
            var turnosSabado = TurnosPorFecha.ContainsKey(sabado) ? TurnosPorFecha[sabado] : new List<Turno>();
            var turnosDomingo = TurnosPorFecha.ContainsKey(domingo) ? TurnosPorFecha[domingo] : new List<Turno>();
            var esSabadoHoy = sabado == DateOnly.FromDateTime(DateTime.Today);
            var esDomingoHoy = domingo == DateOnly.FromDateTime(DateTime.Today);

            <div class="col-finde-semana">
                <!-- Sub-tarjeta SÁBADO (arriba) -->
                <div class="card card-dia-semana card-dia-finde @(esSabadoHoy ? "border-primary shadow-sm" : "")">
                    <div class="card-header-semana p-2 d-flex align-items-center justify-content-between @(esSabadoHoy ? "bg-primary text-white" : "bg-light")">
                        <div>
                            <div class="font-bold dia-titulo">
                                SÁBADO
                                @if (esSabadoHoy)
                                {
                                    <span class="badge bg-white text-primary ms-1" style="font-size: 0.65rem;">HOY</span>
                                }
                            </div>
                            <div class="small opacity-75">@sabado.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            @if (turnosSabado.Any())
                            {
                                <span class="badge @(esSabadoHoy ? "bg-white text-primary" : "bg-primary") badge-pill">@turnosSabado.Count</span>
                            }
                            <button class="btn btn-xs @(esSabadoHoy ? "btn-light text-primary" : "btn-outline-primary")" @onclick="() => AbrirModalNuevoTurnoConFecha(sabado)" title="Agregar turno para Sábado">
                                + Turno
                            </button>
                        </div>
                    </div>
                    <div class="card-body-semana card-body-finde p-2">
                        @if (turnosSabado.Any())
                        {
                            @foreach (var turno in turnosSabado)
                            {
                                @RenderTurnoCard(turno, isRightEdge: true)
                            }
                        }
                        else
                        {
                            <div class="text-muted small text-center py-2 empty-turnos-slot">
                                <div>Sin turnos</div>
                                <button class="btn btn-xs btn-outline-primary mt-1" @onclick="() => AbrirModalNuevoTurnoConFecha(sabado)">
                                    + Agendar
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Sub-tarjeta DOMINGO (abajo) -->
                <div class="card card-dia-semana card-dia-finde @(esDomingoHoy ? "border-primary shadow-sm" : "")">
                    <div class="card-header-semana p-2 d-flex align-items-center justify-content-between @(esDomingoHoy ? "bg-primary text-white" : "bg-light")">
                        <div>
                            <div class="font-bold dia-titulo">
                                DOMINGO
                                @if (esDomingoHoy)
                                {
                                    <span class="badge bg-white text-primary ms-1" style="font-size: 0.65rem;">HOY</span>
                                }
                            </div>
                            <div class="small opacity-75">@domingo.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            @if (turnosDomingo.Any())
                            {
                                <span class="badge @(esDomingoHoy ? "bg-white text-primary" : "bg-primary") badge-pill">@turnosDomingo.Count</span>
                            }
                            <button class="btn btn-xs @(esDomingoHoy ? "btn-light text-primary" : "btn-outline-primary")" @onclick="() => AbrirModalNuevoTurnoConFecha(domingo)" title="Agregar turno para Domingo">
                                + Turno
                            </button>
                        </div>
                    </div>
                    <div class="card-body-semana card-body-finde p-2">
                        @if (turnosDomingo.Any())
                        {
                            @foreach (var turno in turnosDomingo)
                            {
                                @RenderTurnoCard(turno, isRightEdge: true)
                            }
                        }
                        else
                        {
                            <div class="text-muted small text-center py-2 empty-turnos-slot">
                                <div>Sin turnos</div>
                                <button class="btn btn-xs btn-outline-primary mt-1" @onclick="() => AbrirModalNuevoTurnoConFecha(domingo)">
                                    + Agendar
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<!-- Modal Nuevo Turno -->
@if (MostrarModalNuevo)
{
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <h4 class="mb-3 font-bold">Nuevo Turno Médico</h4>
            <EditForm Model="nuevoTurnoDto" OnValidSubmit="GuardarNuevoTurno">
                <div class="mb-3">
                    <label class="form-label font-semibold">Paciente</label>
                    <select class="form-select" @bind="nuevoTurnoDto.IdPaciente">
                        <option value="0">Seleccionar Paciente...</option>
                        @foreach (var pac in ListaPacientes)
                        {
                            var nomPac = pac.Persona != null ? $"{pac.Persona.Nombre} {pac.Persona.Apellido} (DNI {pac.NumDocumento})" : $"Paciente #{pac.IdPaciente}";
                            <option value="@pac.IdPaciente">@nomPac</option>
                        }
                    </select>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Fecha</label>
                        <input type="date" class="form-control" value="@nuevoTurnoDto.Fecha.ToString("yyyy-MM-dd")" @onchange="(e) => nuevoTurnoDto.Fecha = DateOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Hora</label>
                        <input type="time" class="form-control" value="@nuevoTurnoDto.Hora.ToString("HH:mm")" @onchange="(e) => nuevoTurnoDto.Hora = TimeOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label font-semibold">Modalidad de Atención</label>
                    <div class="d-flex gap-2">
                        <div class="modal-check-btn @(nuevoTurnoDto.Modalidad == ModalidadTurno.Presencial ? "active" : "")" @onclick="() => nuevoTurnoDto.Modalidad = ModalidadTurno.Presencial">
                            <input class="form-check-input mt-0" type="radio" name="modalidadNuevo" id="modNuevoPresencial" 
                                   checked="@(nuevoTurnoDto.Modalidad == ModalidadTurno.Presencial)"
                                   @onchange="() => nuevoTurnoDto.Modalidad = ModalidadTurno.Presencial" />
                            <label class="form-check-label mb-0 cursor-pointer" for="modNuevoPresencial">
                                🏥 Presencial (Consultorio)
                            </label>
                        </div>
                        <div class="modal-check-btn @(nuevoTurnoDto.Modalidad == ModalidadTurno.Online ? "active" : "")" @onclick="() => nuevoTurnoDto.Modalidad = ModalidadTurno.Online">
                            <input class="form-check-input mt-0" type="radio" name="modalidadNuevo" id="modNuevoOnline" 
                                   checked="@(nuevoTurnoDto.Modalidad == ModalidadTurno.Online)"
                                   @onchange="() => nuevoTurnoDto.Modalidad = ModalidadTurno.Online" />
                            <label class="form-check-label mb-0 cursor-pointer" for="modNuevoOnline">
                                📹 Online (Videollamada)
                            </label>
                        </div>
                    </div>
                </div>

                @if (nuevoTurnoDto.Modalidad == ModalidadTurno.Online)
                {
                    <div class="mb-3 p-3 rounded border online-config-box">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label font-semibold mb-0">Enlace de Videollamada</label>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Telemedicina</span>
                        </div>
                        <input type="url" class="form-control" @bind="nuevoTurnoDto.EnlaceReunion" 
                               placeholder="https://meet.google.com/... o https://zoom.us/... (opcional)" />
                        <div class="form-text small text-muted mt-1">
                            💡 Opcional. Si no ingresas un enlace, el turno se registrará sin enlace y el botón de acceso permanecerá inhabilitado.
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label font-semibold">Observaciones</label>
                    <textarea class="form-control" rows="2" @bind="nuevoTurnoDto.Observacion" placeholder="Motivo de consulta..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary-custom" @onclick="() => MostrarModalNuevo = false">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">Agendar Turno</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal Turno Recurrente -->
@if (MostrarModalRecurrente)
{
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <h4 class="mb-3 font-bold">Agendar Turnos Recurrentes</h4>
            <EditForm Model="recurrenteDto" OnValidSubmit="GuardarTurnosRecurrentes">
                <div class="mb-3">
                    <label class="form-label font-semibold">Paciente</label>
                    <select class="form-select" @bind="recurrenteDto.IdPaciente">
                        <option value="0">Seleccionar Paciente...</option>
                        @foreach (var pac in ListaPacientes)
                        {
                            var nomPac = pac.Persona != null ? $"{pac.Persona.Nombre} {pac.Persona.Apellido}" : $"Paciente #{pac.IdPaciente}";
                            <option value="@pac.IdPaciente">@nomPac</option>
                        }
                    </select>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Día de la Semana</label>
                        <select class="form-select" @bind="recurrenteDto.DiaSemana">
                            <option value="@DayOfWeek.Monday">Lunes</option>
                            <option value="@DayOfWeek.Tuesday">Martes</option>
                            <option value="@DayOfWeek.Wednesday">Miércoles</option>
                            <option value="@DayOfWeek.Thursday">Jueves</option>
                            <option value="@DayOfWeek.Friday">Viernes</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Hora</label>
                        <input type="time" class="form-control" value="@recurrenteDto.Hora.ToString("HH:mm")" @onchange="(e) => recurrenteDto.Hora = TimeOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Fecha Inicio</label>
                        <input type="date" class="form-control" value="@recurrenteDto.FechaInicio.ToString("yyyy-MM-dd")" @onchange="(e) => recurrenteDto.FechaInicio = DateOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Fecha Fin</label>
                        <input type="date" class="form-control" value="@recurrenteDto.FechaFin.ToString("yyyy-MM-dd")" @onchange="(e) => recurrenteDto.FechaFin = DateOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label font-semibold">Modalidad de Atención</label>
                    <div class="d-flex gap-2">
                        <div class="modal-check-btn @(recurrenteDto.Modalidad == ModalidadTurno.Presencial ? "active" : "")" @onclick="() => recurrenteDto.Modalidad = ModalidadTurno.Presencial">
                            <input class="form-check-input mt-0" type="radio" name="modalidadRecurrente" id="modRecPresencial" 
                                   checked="@(recurrenteDto.Modalidad == ModalidadTurno.Presencial)"
                                   @onchange="() => recurrenteDto.Modalidad = ModalidadTurno.Presencial" />
                            <label class="form-check-label mb-0 cursor-pointer" for="modRecPresencial">
                                🏥 Presencial (Consultorio)
                            </label>
                        </div>
                        <div class="modal-check-btn @(recurrenteDto.Modalidad == ModalidadTurno.Online ? "active" : "")" @onclick="() => recurrenteDto.Modalidad = ModalidadTurno.Online">
                            <input class="form-check-input mt-0" type="radio" name="modalidadRecurrente" id="modRecOnline" 
                                   checked="@(recurrenteDto.Modalidad == ModalidadTurno.Online)"
                                   @onchange="() => recurrenteDto.Modalidad = ModalidadTurno.Online" />
                            <label class="form-check-label mb-0 cursor-pointer" for="modRecOnline">
                                📹 Online (Videollamada)
                            </label>
                        </div>
                    </div>
                </div>

                @if (recurrenteDto.Modalidad == ModalidadTurno.Online)
                {
                    <div class="mb-3 p-3 rounded border online-config-box">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label font-semibold mb-0">Enlace de Videollamada</label>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Telemedicina</span>
                        </div>
                        <input type="url" class="form-control" @bind="recurrenteDto.EnlaceReunion" 
                               placeholder="https://meet.google.com/... o https://zoom.us/... (opcional)" />
                        <div class="form-text small text-muted mt-1">
                            💡 Opcional. Si no ingresas un enlace, el turno se registrará sin enlace y el botón de acceso permanecerá inhabilitado.
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary-custom" @onclick="() => MostrarModalRecurrente = false">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">Generar Serie de Turnos</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Pop-up Cartel / Modal de Cambio de Estado con Máxima Prioridad -->
@if (mostrarModalEstado && turnoSeleccionado != null)
{
    <div class="modal-overlay-priority" @onclick="CerrarModalEstado">
        <div class="modal-card-priority" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span style="font-size: 1.25rem;">📝</span>
                    <h5 class="m-0 font-bold text-dark">Cambiar Estado del Turno</h5>
                </div>
                <button type="button" class="btn-close" @onclick="CerrarModalEstado" title="Cerrar"></button>
            </div>

            <div class="mb-3">
                <div class="p-2 mb-3 bg-light rounded border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">Paciente:</span>
                        <span class="font-bold text-dark">@GetNombrePaciente(turnoSeleccionado.IdPaciente)</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">Fecha y Hora:</span>
                        <span class="font-semibold text-secondary">
                            @turnoSeleccionado.Fecha.ToString("dd/MM/yyyy") - @turnoSeleccionado.Hora.ToString("HH:mm") hs
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Estado actual:</span>
                        <span class="badge-estado @GetBadgeClass(turnoSeleccionado.Estado)">
                            @GetEstadoTextoConIcono(turnoSeleccionado.Estado)
                        </span>
                    </div>
                </div>

                <label class="form-label font-semibold mb-2">Seleccionar Estado:</label>
                <select class="form-select mb-3" @bind="estadoSeleccionado">
                    @foreach (var estado in Enum.GetValues<EstadoTurno>())
                    {
                        <option value="@estado">@estado</option>
                    }
                </select>

                <div class="d-flex flex-column gap-1">
                    <button type="button" class="btn-state-item btn-state-activo @(estadoSeleccionado == EstadoTurno.Activo ? "state-current" : "")" @onclick="() => estadoSeleccionado = EstadoTurno.Activo">
                        <span class="state-icon-circle bg-activo">✓</span>
                        <span>Activo</span>
                        @if (estadoSeleccionado == EstadoTurno.Activo)
                        {
                            <span class="badge-current-mark ms-auto">Seleccionado</span>
                        }
                    </button>
                    <button type="button" class="btn-state-item btn-state-completo @(estadoSeleccionado == EstadoTurno.Completo ? "state-current" : "")" @onclick="() => estadoSeleccionado = EstadoTurno.Completo">
                        <span class="state-icon-circle bg-completo">✓</span>
                        <span>Completo</span>
                        @if (estadoSeleccionado == EstadoTurno.Completo)
                        {
                            <span class="badge-current-mark ms-auto">Seleccionado</span>
                        }
                    </button>
                    <button type="button" class="btn-state-item btn-state-falta @(estadoSeleccionado == EstadoTurno.Falta ? "state-current" : "")" @onclick="() => estadoSeleccionado = EstadoTurno.Falta">
                        <span class="state-icon-circle bg-falta">⚠</span>
                        <span>Falta</span>
                        @if (estadoSeleccionado == EstadoTurno.Falta)
                        {
                            <span class="badge-current-mark ms-auto">Seleccionado</span>
                        }
                    </button>
                    <button type="button" class="btn-state-item btn-state-cancelado @(estadoSeleccionado == EstadoTurno.Cancelado ? "state-current" : "")" @onclick="() => estadoSeleccionado = EstadoTurno.Cancelado">
                        <span class="state-icon-circle bg-cancelado">✕</span>
                        <span>Cancelado</span>
                        @if (estadoSeleccionado == EstadoTurno.Cancelado)
                        {
                            <span class="badge-current-mark ms-auto">Seleccionado</span>
                        }
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                <button type="button" class="btn btn-secondary-custom" @onclick="CerrarModalEstado">Cancelar</button>
                <button type="button" class="btn btn-primary-custom" @onclick="GuardarEstado">Guardar</button>
            </div>
        </div>
    </div>
}

@code {
    private RenderFragment RenderTurnoCard(Turno turno, bool isRightEdge) => __builder =>
    {
        <div class="turno-box-semana mb-2 p-2 border rounded @GetBorderAccentClass(turno.Estado) @(PopoverTurnoId == turno.IdTurno ? "active-popover" : "")" style="position: relative;">
            <!-- Fila Superior: Badges y Hora -->
            <div class="d-flex justify-content-between align-items-center mb-1">
                <div class="d-flex align-items-center gap-1 flex-wrap">
                    <span class="badge-estado @GetBadgeClass(turno.Estado)">@GetEstadoTextoConIcono(turno.Estado)</span>
                    @if (turno.Modalidad == ModalidadTurno.Online)
                    {
                        <span class="badge badge-modalidad-online-sm" title="Turno Online (Videollamada)">📹 Online</span>
                    }
                </div>
                <span class="badge bg-light text-dark border font-semibold" style="font-size: 0.72rem;">@turno.Hora.ToString("HH:mm") hs</span>
            </div>

            <!-- Fila Paciente y Observación -->
            <div class="paciente-semana-nombre font-bold text-truncate" title="@GetNombrePaciente(turno.IdPaciente)">
                @GetNombrePaciente(turno.IdPaciente)
            </div>
            @if (!string.IsNullOrWhiteSpace(turno.Observacion))
            {
                <div class="text-muted text-truncate italic micro-text" title="@turno.Observacion">
                    @turno.Observacion
                </div>
            }

            <!-- Fila de Acciones: Videollamada, Comprobante PDF, Estado -->
            <div class="mt-2 d-flex flex-column gap-1">
                @if (turno.Modalidad == ModalidadTurno.Online && !string.IsNullOrWhiteSpace(turno.EnlaceReunion) && turno.Estado == EstadoTurno.Activo)
                {
                    <a href="@turno.EnlaceReunion" target="_blank" class="btn btn-xs btn-join-videocall py-1 px-2 w-100 text-center text-truncate" title="Unirse a la videollamada">
                        <span class="video-icon-pulse">●</span> 📹 Unirse a llamada
                    </a>
                }

                <div class="d-flex gap-1 align-items-center">
                    @if (turno.Estado == EstadoTurno.Completo)
                    {
                        <a href="@GetPdfUrl(turno.IdTurno)" target="_blank" class="btn btn-xs btn-outline-success py-1 px-2 flex-grow-1 text-center text-truncate" style="font-size: 0.72rem;" title="Descargar comprobante de atención en PDF">
                            📄 PDF
                        </a>
                    }
                    <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 @(turno.Estado == EstadoTurno.Completo ? "" : "w-100") text-center" style="font-size: 0.72rem;" @onclick="() => AbrirModalEstado(turno)" title="Cambiar estado del turno">
                        Estado &blacktriangledown;
                    </button>
                </div>
            </div>
        </div>
    };
}

