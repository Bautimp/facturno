@code {
    private RenderFragment RenderTurnoCard(Turno turno, bool isRightEdge) => __builder =>
    {
        <div class="turno-box-semana mb-2 p-2 border rounded @GetBorderAccentClass(turno.Estado) @(PopoverTurnoId == turno.IdTurno ? "active-popover" : "")" 
             style="position: relative; cursor: pointer;" 
             @onclick="() => AbrirModalEstado(turno)" 
             title="Haga clic en la tarjeta para ver detalles y gestionar este turno">
            <!-- Fila Superior: Badges y Hora -->
            <div class="d-flex justify-content-between align-items-center mb-1">
                <div class="d-flex align-items-center gap-1 flex-wrap">
                    <span class="badge-estado @GetBadgeClass(turno.Estado) d-inline-flex align-items-center gap-1">
                        @if (turno.Estado == EstadoTurno.Activo)
                        {
                            <i class="bi bi-check-circle" aria-hidden="true"></i>
                        }
                        else if (turno.Estado == EstadoTurno.Completo)
                        {
                            <i class="bi bi-check-all" aria-hidden="true"></i>
                        }
                        else if (turno.Estado == EstadoTurno.Falta)
                        {
                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                        }
                        else if (turno.Estado == EstadoTurno.Cancelado)
                        {
                            <i class="bi bi-x-circle" aria-hidden="true"></i>
                        }
                        <span>@GetEstadoTextoConIcono(turno.Estado)</span>
                    </span>
                    @if (turno.Modalidad == ModalidadTurno.Online)
                    {
                        <span class="badge badge-modalidad-online-sm d-inline-flex align-items-center gap-1" title="Turno Online (Videollamada)">
                            <i class="bi bi-camera-video" aria-hidden="true"></i>
                            <span>Online</span>
                        </span>
                    }
                </div>
                <span class="badge bg-light text-dark border font-semibold" style="font-size: 0.72rem;">@turno.Hora.ToString("HH:mm")</span>
            </div>

            <!-- Fila Paciente -->
            <div class="paciente-semana-nombre font-bold text-truncate" title="@GetNombrePaciente(turno.IdPaciente)">
                @GetNombrePaciente(turno.IdPaciente)
            </div>

            <!-- Acciones complementarias (Videollamada / Comprobante PDF) -->
            @if ((turno.Modalidad == ModalidadTurno.Online && !string.IsNullOrWhiteSpace(turno.EnlaceReunion) && turno.Estado == EstadoTurno.Activo) || turno.Estado == EstadoTurno.Completo)
            {
                <div class="mt-2 d-flex flex-column gap-1" @onclick:stopPropagation="true">
                    @if (turno.Modalidad == ModalidadTurno.Online && !string.IsNullOrWhiteSpace(turno.EnlaceReunion) && turno.Estado == EstadoTurno.Activo)
                    {
                        <a href="@turno.EnlaceReunion" target="_blank" class="btn btn-xs btn-join-videocall py-1 px-2 w-100 text-center text-truncate" title="Unirse a la videollamada">
                            <span class="video-icon-pulse">●</span>
                            <i class="bi bi-camera-video-fill ms-1 me-1" aria-hidden="true"></i>
                            <span>Unirse a llamada</span>
                        </a>
                    }

                    @if (turno.Estado == EstadoTurno.Completo)
                    {
                        <a href="@GetPdfUrl(turno.IdTurno)" target="_blank" class="btn btn-xs btn-outline-success py-1 px-2 w-100 text-center text-truncate d-inline-flex align-items-center justify-content-center gap-1" style="font-size: 0.72rem;" title="Descargar comprobante de atención en PDF">
                            <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                            <span>Comprobante PDF</span>
                        </a>
                    }
                </div>
            }
        </div>
    };
}

