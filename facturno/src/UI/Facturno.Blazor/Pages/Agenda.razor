@page "/agenda"
@attribute [Authorize]

<SystemPopupMessage Message="@MensajeAlerta" OnClose="() => MensajeAlerta = null" />

<div class="facturno-card" style="position: relative;">
    <LoadingOverlay IsLoading="IsLoading" Text="Cargando agenda de turnos..." />
    @if (PopoverTurnoId != null)
    {
        <div class="popover-backdrop" @onclick="CerrarPopover"></div>
    }
    <div class="card-header-custom">
        <div class="agenda-title-block">
            <h3 class="m-0 font-bold">Agenda y Turnos Médicos</h3>
            <p class="text-muted m-0 small">Gestión clínica y control asistencial de citas</p>
        </div>
        <div class="agenda-header-actions">
            <button class="btn btn-primary-custom btn-sm agenda-action-btn" @onclick="AbrirModalNuevoTurno">
                + Nuevo Turno
            </button>

            <button class="btn btn-outline-primary btn-sm agenda-action-btn d-inline-flex align-items-center justify-content-center gap-1" @onclick="AbrirModalTurnoRecurrente">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                <span>Turno Recurrente</span>
            </button>
        </div>
    </div>

    <!-- Barra Unificada y Organizada de Navegación y Filtros -->
    <div class="semana-nav-bar mb-3 p-3 bg-white rounded border shadow-sm">
        <!-- Fila Superior: Navegación por Semanas y Rango -->
        <div class="semana-nav-row d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2 pb-2 border-bottom">
            <div class="btn-group btn-group-sm semana-nav-btn-group" role="group">
                <button type="button" class="btn btn-outline-primary font-semibold" @onclick="SemanaAnterior" title="Semana anterior">
                    <span class="nav-arrow">&larr;</span> Anterior
                </button>
                <button type="button" class="btn btn-outline-secondary font-semibold" @onclick="IrSemanaActual" title="Volver a la semana actual">
                    Hoy
                </button>
                <button type="button" class="btn btn-outline-primary font-semibold" @onclick="SemanaSiguiente" title="Semana siguiente">
                    Siguiente <span class="nav-arrow">&rarr;</span>
                </button>
            </div>

            <div class="semana-rango-badge d-inline-flex align-items-center gap-2">
                <i class="bi bi-calendar3 text-primary" aria-hidden="true" style="font-size: 1.1rem;"></i>
                <span class="font-bold text-primary semana-rango-titulo">
                    @GetTextoRangoSemana()
                </span>
            </div>
        </div>

        <!-- Fila de Filtros y Contador (En móvil: Grid 2 columnas limpio y proporcionado) -->
        <div class="semana-filters-container">
            @if (!EsProfesionalLogueado)
            {
                <div class="filter-group filter-group-profesional">
                    <label class="form-label font-semibold small text-muted mb-1">Médico:</label>
                    <select class="form-select form-select-sm" @onchange="OnProfesionalChanged">
                        @foreach (var prof in ListaProfesionales)
                        {
                            var nombre = prof.Usuario?.Persona != null ? $"{prof.Usuario.Persona.Nombre} {prof.Usuario.Persona.Apellido} ({prof.Especialidad})" : "Profesional";
                            <option value="@prof.IdProfesional" selected="@(prof.IdProfesional == SelectedProfesionalId)">@nombre</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="filter-group filter-group-profesional">
                    <label class="form-label font-semibold small text-muted mb-1">Médico:</label>
                    <span class="badge bg-light text-dark border font-semibold py-2 px-2 d-inline-flex align-items-center gap-1 w-100">
                        <i class="bi bi-person-badge text-primary" aria-hidden="true"></i>
                        <span>@GetNombreProfesionalSeleccionado()</span>
                    </span>
                </div>
            }

            <div class="filter-group filter-group-estado">
                <label class="form-label font-semibold small text-muted mb-1">Estado:</label>
                <select class="form-select form-select-sm" value="@(FiltroEstado?.ToString() ?? "")" @onchange="OnFiltroEstadoChanged">
                    <option value="">Todos</option>
                    <option value="@EstadoTurno.Activo">Activo</option>
                    <option value="@EstadoTurno.Completo">Completo</option>
                    <option value="@EstadoTurno.Falta">Falta</option>
                    <option value="@EstadoTurno.Cancelado">Cancelado</option>
                </select>
            </div>

            <div class="filter-group filter-group-fecha">
                <label class="form-label font-semibold small text-muted mb-1">Fecha:</label>
                <input type="date" class="form-control form-control-sm" value="@SelectedFecha.ToString("yyyy-MM-dd")" @onchange="OnFechaChanged" title="Seleccionar fecha" />
            </div>

            <div class="filter-group filter-group-contador">
                <label class="form-label font-semibold small text-muted mb-1 d-none d-md-block">&nbsp;</label>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 font-semibold w-100 text-center d-flex align-items-center justify-content-center" title="Total de citas en la semana">
                    @GetTotalTurnosSemana() citas agendadas
                </span>
            </div>
        </div>
    </div>

    <!-- Selector de Día en Móviles (< 768px, Requerimiento 7) -->
    <div class="d-md-none mb-3">
        <div class="mobile-days-scroller">
            @for (int i = 0; i < DiasSemana.Count; i++)
            {
                var idx = i;
                var d = DiasSemana[idx];
                var esHoy = d == DateOnly.FromDateTime(DateTime.Today);
                var esActivo = idx == IndiceDiaMobile;
                var cantidad = ObtenerTurnosFiltradosPorDia(d).Count;
                <button type="button" 
                        class="btn btn-sm flex-fill text-nowrap mobile-day-tab @(esActivo ? "btn-primary text-white" : "btn-light border")"
                        @onclick="() => SeleccionarDiaMobile(idx)">
                    <div class="font-bold">@d.ToString("ddd", new System.Globalization.CultureInfo("es-ES")).ToUpper()</div>
                    <div class="small">@d.ToString("dd/MM")</div>
                    @if (cantidad > 0)
                    {
                        <span class="badge @(esActivo ? "bg-white text-primary" : "bg-primary text-white") rounded-pill mt-1">@cantidad</span>
                    }
                </button>
            }
        </div>
    </div>

    <!-- VISTA SEMANAL (6 Columnas en Desktop; 1 Día activo responsivo en Móvil) -->
    <div class="semana-grid-container">
        @for (int i = 0; i < Math.Min(5, DiasSemana.Count); i++)
        {
            var dia = DiasSemana[i];
            var turnosDelDia = ObtenerTurnosFiltradosPorDia(dia);
            var esHoy = dia == DateOnly.FromDateTime(DateTime.Today);
            var isRightEdge = i >= 3;
            var diaNombre = dia.ToString("dddd", new System.Globalization.CultureInfo("es-ES")).ToUpper();

            <div class="col-dia-semana @(i == IndiceDiaMobile ? "d-block" : "d-none d-md-block")">
                <div class="card card-dia-semana @(esHoy ? "border-primary shadow-sm" : "")">
                    <div class="card-header-semana p-2 d-flex align-items-center justify-content-between @(esHoy ? "bg-primary text-white" : "bg-light")">
                        <div>
                            <div class="font-bold dia-titulo">
                                @diaNombre
                                @if (esHoy)
                                {
                                    <span class="badge bg-white text-primary ms-1" style="font-size: 0.65rem;">HOY</span>
                                }
                            </div>
                            <div class="small opacity-75">@dia.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            @if (turnosDelDia.Any())
                            {
                                <span class="badge @(esHoy ? "bg-white text-primary" : "bg-primary") badge-pill">@turnosDelDia.Count</span>
                            }
                            <button class="btn btn-xs @(esHoy ? "btn-light text-primary" : "btn-outline-primary")" @onclick="() => AbrirModalNuevoTurnoConFecha(dia)" title="Agregar turno este día">
                                + Turno
                            </button>
                        </div>
                    </div>
                    <div class="card-body-semana p-2">
                        @if (turnosDelDia.Any())
                        {
                            @foreach (var turno in turnosDelDia)
                            {
                                @RenderTurnoCard(turno, isRightEdge)
                            }
                        }
                        else
                        {
                            <div class="text-muted small text-center py-4 empty-turnos-slot">
                                <div>Sin turnos agendados</div>
                                <button class="btn btn-xs btn-outline-primary mt-2" @onclick="() => AbrirModalNuevoTurnoConFecha(dia)">
                                    + Agendar cita
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Columna 6: Sábado y Domingo compartiendo un único espacio vertical (uno abajo del otro en Desktop) -->
        @if (DiasSemana.Count >= 7)
        {
            var sabado = DiasSemana[5];
            var domingo = DiasSemana[6];
            var turnosSabado = ObtenerTurnosFiltradosPorDia(sabado);
            var turnosDomingo = ObtenerTurnosFiltradosPorDia(domingo);
            var esSabadoHoy = sabado == DateOnly.FromDateTime(DateTime.Today);
            var esDomingoHoy = domingo == DateOnly.FromDateTime(DateTime.Today);

            <div class="col-finde-semana @(IndiceDiaMobile >= 5 ? "d-block" : "d-none d-md-flex")">
                <!-- Sub-tarjeta SÁBADO (arriba) -->
                <div class="card card-dia-semana card-dia-finde @(esSabadoHoy ? "border-primary shadow-sm" : "") @(IndiceDiaMobile == 6 ? "d-none d-md-flex" : "d-flex")">
                    <div class="card-header-semana p-2 d-flex align-items-center justify-content-between @(esSabadoHoy ? "bg-primary text-white" : "bg-light")">
                        <div>
                            <div class="font-bold dia-titulo">
                                SÁBADO
                                @if (esSabadoHoy)
                                {
                                    <span class="badge bg-white text-primary ms-1" style="font-size: 0.65rem;">HOY</span>
                                }
                            </div>
                            <div class="small opacity-75">@sabado.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            @if (turnosSabado.Any())
                            {
                                <span class="badge @(esSabadoHoy ? "bg-white text-primary" : "bg-primary") badge-pill">@turnosSabado.Count</span>
                            }
                            <button class="btn btn-xs @(esSabadoHoy ? "btn-light text-primary" : "btn-outline-primary")" @onclick="() => AbrirModalNuevoTurnoConFecha(sabado)" title="Agregar turno para Sábado">
                                + Turno
                            </button>
                        </div>
                    </div>
                    <div class="card-body-semana card-body-finde p-2">
                        @if (turnosSabado.Any())
                        {
                            @foreach (var turno in turnosSabado)
                            {
                                @RenderTurnoCard(turno, isRightEdge: true)
                            }
                        }
                        else
                        {
                            <div class="text-muted small text-center py-2 empty-turnos-slot">
                                <div>Sin turnos</div>
                                <button class="btn btn-xs btn-outline-primary mt-1" @onclick="() => AbrirModalNuevoTurnoConFecha(sabado)">
                                    + Agendar
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Sub-tarjeta DOMINGO (abajo) -->
                <div class="card card-dia-semana card-dia-finde @(esDomingoHoy ? "border-primary shadow-sm" : "") @(IndiceDiaMobile == 5 ? "d-none d-md-flex" : "d-flex")">
                    <div class="card-header-semana p-2 d-flex align-items-center justify-content-between @(esDomingoHoy ? "bg-primary text-white" : "bg-light")">
                        <div>
                            <div class="font-bold dia-titulo">
                                DOMINGO
                                @if (esDomingoHoy)
                                {
                                    <span class="badge bg-white text-primary ms-1" style="font-size: 0.65rem;">HOY</span>
                                }
                            </div>
                            <div class="small opacity-75">@domingo.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            @if (turnosDomingo.Any())
                            {
                                <span class="badge @(esDomingoHoy ? "bg-white text-primary" : "bg-primary") badge-pill">@turnosDomingo.Count</span>
                            }
                            <button class="btn btn-xs @(esDomingoHoy ? "btn-light text-primary" : "btn-outline-primary")" @onclick="() => AbrirModalNuevoTurnoConFecha(domingo)" title="Agregar turno para Domingo">
                                + Turno
                            </button>
                        </div>
                    </div>
                    <div class="card-body-semana card-body-finde p-2">
                        @if (turnosDomingo.Any())
                        {
                            @foreach (var turno in turnosDomingo)
                            {
                                @RenderTurnoCard(turno, isRightEdge: true)
                            }
                        }
                        else
                        {
                            <div class="text-muted small text-center py-2 empty-turnos-slot">
                                <div>Sin turnos</div>
                                <button class="btn btn-xs btn-outline-primary mt-1" @onclick="() => AbrirModalNuevoTurnoConFecha(domingo)">
                                    + Agendar
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<!-- Modal Nuevo Turno -->
@if (MostrarModalNuevo)
{
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <h4 class="mb-3 font-bold">Nuevo Turno Médico</h4>
            <EditForm Model="nuevoTurnoDto" OnValidSubmit="GuardarNuevoTurno">
                <!-- Selección y Búsqueda Difusa de Paciente -->
                <div class="mb-3 position-relative">
                    <label class="form-label font-semibold d-flex justify-content-between align-items-center mb-1">
                        <span>Paciente <span class="text-danger">*</span></span>
                        @if (nuevoTurnoDto.IdPaciente > 0)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                                <i class="bi bi-check2" aria-hidden="true"></i> Seleccionado
                            </span>
                        }
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted">
                            <i class="bi bi-search" aria-hidden="true"></i>
                        </span>
                        <input type="text" 
                               class="form-control" 
                               placeholder="Buscar por nombre, apellido (ej: Gonzales, Matias)..." 
                               value="@TextoBusquedaPacienteNuevo"
                               @oninput="OnBusquedaPacienteNuevoInput"
                               @onfocus="() => MostrarDropdownPacientesNuevo = true" />
                        @if (!string.IsNullOrWhiteSpace(TextoBusquedaPacienteNuevo) || nuevoTurnoDto.IdPaciente > 0)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarSeleccionPacienteNuevo" title="Limpiar búsqueda">
                                <i class="bi bi-x-lg" aria-hidden="true"></i>
                            </button>
                        }
                    </div>

                    @if (PacienteSeleccionadoNuevo != null)
                    {
                        <div class="p-2 mt-2 bg-light border border-success-subtle rounded d-flex justify-content-between align-items-center">
                            <div>
                                <div class="font-bold text-success d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-person-fill" aria-hidden="true"></i> @PacienteSeleccionadoNuevo.Persona?.Nombre @PacienteSeleccionadoNuevo.Persona?.Apellido
                                </div>
                                <div class="small text-muted">
                                    DNI: @(PacienteSeleccionadoNuevo.NumDocumento ?? "S/D") | Tel: @(PacienteSeleccionadoNuevo.Persona?.Telefono?.ToString() ?? "S/T")
                                </div>
                            </div>
                            <button type="button" class="btn btn-xs btn-outline-secondary" @onclick="LimpiarSeleccionPacienteNuevo">
                                Cambiar
                            </button>
                        </div>
                    }

                    @if (MostrarDropdownPacientesNuevo)
                    {
                        <div class="dropdown-pacientes-list shadow">
                            @if (PacientesFiltradosNuevo.Any())
                            {
                                <div class="p-2 text-muted small bg-light border-bottom d-flex justify-content-between align-items-center">
                                    <span>Resultados (@PacientesFiltradosNuevo.Count)</span>
                                    <button type="button" class="btn btn-xs btn-link p-0 text-decoration-none text-muted d-inline-flex align-items-center gap-1" @onclick="() => MostrarDropdownPacientesNuevo = false">
                                        <span>Cerrar</span> <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div class="dropdown-pacientes-scroll">
                                    @foreach (var pac in PacientesFiltradosNuevo)
                                    {
                                        var esSeleccionado = pac.IdPaciente == nuevoTurnoDto.IdPaciente;
                                        <div class="dropdown-paciente-item p-2 @(esSeleccionado ? "paciente-item-active" : "")" 
                                             @onclick="() => SeleccionarPacienteNuevo(pac)">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="font-semibold text-dark">
                                                    @pac.Persona?.Nombre @pac.Persona?.Apellido
                                                </span>
                                                <span class="badge bg-light text-secondary border font-normal" style="font-size: 0.7rem;">
                                                    DNI @(pac.NumDocumento ?? "S/D")
                                                </span>
                                            </div>
                                            @if (pac.Persona?.Telefono != null || !string.IsNullOrWhiteSpace(pac.Persona?.Correo))
                                            {
                                                <div class="text-muted micro-text text-truncate">
                                                    @(pac.Persona?.Correo ?? "") @(pac.Persona?.Telefono != null ? $"· Tel: {pac.Persona.Telefono}" : "")
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="p-3 text-center text-muted small">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-exclamation-triangle-fill text-warning" aria-hidden="true"></i>
                                        <span>No se encontró ningún paciente similar a <strong>"@TextoBusquedaPacienteNuevo"</strong></span>
                                    </div>
                                    <div class="micro-text mt-1 text-secondary">Verifica que el paciente esté dado de alta en la sección Pacientes.</div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Fecha</label>
                        <input type="date" 
                               class="form-control" 
                               min="@FechaMinimaPermitidaIso"
                               @bind="nuevoTurnoDto.Fecha" 
                               @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Hora</label>
                        <input type="text" 
                               class="form-control" 
                               list="lista-horas-24"
                               placeholder="16:00"
                               maxlength="5"
                               @bind="HoraNuevoTexto" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label font-semibold">Modalidad de Atención</label>
                    <div class="d-flex gap-2">
                        <div class="modal-check-btn @(nuevoTurnoDto.Modalidad == ModalidadTurno.Presencial ? "active" : "")" @onclick="() => nuevoTurnoDto.Modalidad = ModalidadTurno.Presencial">
                            <input class="form-check-input mt-0" type="radio" name="modalidadNuevo" id="modNuevoPresencial" 
                                   checked="@(nuevoTurnoDto.Modalidad == ModalidadTurno.Presencial)"
                                   @onchange="() => nuevoTurnoDto.Modalidad = ModalidadTurno.Presencial" />
                            <label class="form-check-label mb-0 cursor-pointer d-inline-flex align-items-center gap-1" for="modNuevoPresencial">
                                <i class="bi bi-hospital" aria-hidden="true"></i> Presencial (Consultorio)
                            </label>
                        </div>
                        <div class="modal-check-btn @(nuevoTurnoDto.Modalidad == ModalidadTurno.Online ? "active" : "")" @onclick="() => nuevoTurnoDto.Modalidad = ModalidadTurno.Online">
                            <input class="form-check-input mt-0" type="radio" name="modalidadNuevo" id="modNuevoOnline" 
                                   checked="@(nuevoTurnoDto.Modalidad == ModalidadTurno.Online)"
                                   @onchange="() => nuevoTurnoDto.Modalidad = ModalidadTurno.Online" />
                            <label class="form-check-label mb-0 cursor-pointer d-inline-flex align-items-center gap-1" for="modNuevoOnline">
                                <i class="bi bi-camera-video" aria-hidden="true"></i> Online (Videollamada)
                            </label>
                        </div>
                    </div>
                </div>

                @if (nuevoTurnoDto.Modalidad == ModalidadTurno.Online)
                {
                    <div class="mb-3 p-3 rounded border online-config-box">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label font-semibold mb-0">Enlace de Videollamada</label>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Telemedicina</span>
                        </div>
                        <input type="url" class="form-control" @bind="nuevoTurnoDto.EnlaceReunion" 
                               placeholder="https://meet.google.com/... o https://zoom.us/... (opcional)" />
                        <div class="form-text small text-muted mt-1 d-inline-flex align-items-center gap-1">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            <span>Opcional. Si no ingresas un enlace, el turno se registrará sin enlace y el botón de acceso permanecerá inhabilitado.</span>
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label font-semibold">Observaciones</label>
                    <textarea class="form-control" rows="2" @bind="nuevoTurnoDto.Observacion" placeholder="Motivo de consulta..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary-custom" @onclick="() => MostrarModalNuevo = false">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">Agendar Turno</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal Turno Recurrente -->
@if (MostrarModalRecurrente)
{
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <h4 class="mb-3 font-bold">Agendar Turnos Recurrentes</h4>
            <EditForm Model="recurrenteDto" OnValidSubmit="GuardarTurnosRecurrentes">
                <!-- Selección y Búsqueda Difusa de Paciente para Turno Recurrente -->
                <div class="mb-3 position-relative">
                    <label class="form-label font-semibold d-flex justify-content-between align-items-center mb-1">
                        <span>Paciente <span class="text-danger">*</span></span>
                        @if (recurrenteDto.IdPaciente > 0)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                                <i class="bi bi-check2" aria-hidden="true"></i> Seleccionado
                            </span>
                        }
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted">
                            <i class="bi bi-search" aria-hidden="true"></i>
                        </span>
                        <input type="text" 
                               class="form-control" 
                               placeholder="Buscar por nombre, apellido (ej: Gonzales, Matias)..." 
                               value="@TextoBusquedaPacienteRecurrente"
                               @oninput="OnBusquedaPacienteRecurrenteInput"
                               @onfocus="() => MostrarDropdownPacientesRecurrente = true" />
                        @if (!string.IsNullOrWhiteSpace(TextoBusquedaPacienteRecurrente) || recurrenteDto.IdPaciente > 0)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarSeleccionPacienteRecurrente" title="Limpiar búsqueda">
                                <i class="bi bi-x-lg" aria-hidden="true"></i>
                            </button>
                        }
                    </div>

                    @if (PacienteSeleccionadoRecurrente != null)
                    {
                        <div class="p-2 mt-2 bg-light border border-success-subtle rounded d-flex justify-content-between align-items-center">
                            <div>
                                <div class="font-bold text-success d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-person-fill" aria-hidden="true"></i> @PacienteSeleccionadoRecurrente.Persona?.Nombre @PacienteSeleccionadoRecurrente.Persona?.Apellido
                                </div>
                                <div class="small text-muted">
                                    DNI: @(PacienteSeleccionadoRecurrente.NumDocumento ?? "S/D")
                                </div>
                            </div>
                            <button type="button" class="btn btn-xs btn-outline-secondary" @onclick="LimpiarSeleccionPacienteRecurrente">
                                Cambiar
                            </button>
                        </div>
                    }

                    @if (MostrarDropdownPacientesRecurrente)
                    {
                        <div class="dropdown-pacientes-list shadow">
                            @if (PacientesFiltradosRecurrente.Any())
                            {
                                <div class="p-2 text-muted small bg-light border-bottom d-flex justify-content-between align-items-center">
                                    <span>Resultados (@PacientesFiltradosRecurrente.Count)</span>
                                    <button type="button" class="btn btn-xs btn-link p-0 text-decoration-none text-muted d-inline-flex align-items-center gap-1" @onclick="() => MostrarDropdownPacientesRecurrente = false">
                                        <span>Cerrar</span> <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div class="dropdown-pacientes-scroll">
                                    @foreach (var pac in PacientesFiltradosRecurrente)
                                    {
                                        var esSeleccionado = pac.IdPaciente == recurrenteDto.IdPaciente;
                                        <div class="dropdown-paciente-item p-2 @(esSeleccionado ? "paciente-item-active" : "")" 
                                             @onclick="() => SeleccionarPacienteRecurrente(pac)">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="font-semibold text-dark">
                                                    @pac.Persona?.Nombre @pac.Persona?.Apellido
                                                </span>
                                                <span class="badge bg-light text-secondary border font-normal" style="font-size: 0.7rem;">
                                                    DNI @(pac.NumDocumento ?? "S/D")
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="p-3 text-center text-muted small">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-exclamation-triangle-fill text-warning" aria-hidden="true"></i>
                                        <span>No se encontró ningún paciente similar a <strong>"@TextoBusquedaPacienteRecurrente"</strong></span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Día de la Semana</label>
                        <select class="form-select" @bind="recurrenteDto.DiaSemana">
                            <option value="@DayOfWeek.Monday">Lunes</option>
                            <option value="@DayOfWeek.Tuesday">Martes</option>
                            <option value="@DayOfWeek.Wednesday">Miércoles</option>
                            <option value="@DayOfWeek.Thursday">Jueves</option>
                            <option value="@DayOfWeek.Friday">Viernes</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Hora</label>
                        <input type="text" 
                               class="form-control" 
                               list="lista-horas-24"
                               placeholder="16:00"
                               maxlength="5"
                               @bind="HoraRecurrenteTexto" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Fecha Inicio</label>
                        <input type="date" 
                               class="form-control" 
                               min="@FechaMinimaPermitidaIso"
                               @bind="recurrenteDto.FechaInicio" 
                               @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Fecha Fin</label>
                        <input type="date" 
                               class="form-control" 
                               @bind="recurrenteDto.FechaFin" 
                               @bind:format="yyyy-MM-dd" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label font-semibold">Modalidad de Atención</label>
                    <div class="d-flex gap-2">
                        <div class="modal-check-btn @(recurrenteDto.Modalidad == ModalidadTurno.Presencial ? "active" : "")" @onclick="() => recurrenteDto.Modalidad = ModalidadTurno.Presencial">
                            <input class="form-check-input mt-0" type="radio" name="modalidadRecurrente" id="modRecPresencial" 
                                   checked="@(recurrenteDto.Modalidad == ModalidadTurno.Presencial)"
                                   @onchange="() => recurrenteDto.Modalidad = ModalidadTurno.Presencial" />
                            <label class="form-check-label mb-0 cursor-pointer d-inline-flex align-items-center gap-1" for="modRecPresencial">
                                <i class="bi bi-hospital" aria-hidden="true"></i> Presencial (Consultorio)
                            </label>
                        </div>
                        <div class="modal-check-btn @(recurrenteDto.Modalidad == ModalidadTurno.Online ? "active" : "")" @onclick="() => recurrenteDto.Modalidad = ModalidadTurno.Online">
                            <input class="form-check-input mt-0" type="radio" name="modalidadRecurrente" id="modRecOnline" 
                                   checked="@(recurrenteDto.Modalidad == ModalidadTurno.Online)"
                                   @onchange="() => recurrenteDto.Modalidad = ModalidadTurno.Online" />
                            <label class="form-check-label mb-0 cursor-pointer d-inline-flex align-items-center gap-1" for="modRecOnline">
                                <i class="bi bi-camera-video" aria-hidden="true"></i> Online (Videollamada)
                            </label>
                        </div>
                    </div>
                </div>

                @if (recurrenteDto.Modalidad == ModalidadTurno.Online)
                {
                    <div class="mb-3 p-3 rounded border online-config-box">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label font-semibold mb-0">Enlace de Videollamada</label>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Telemedicina</span>
                        </div>
                        <input type="url" class="form-control" @bind="recurrenteDto.EnlaceReunion" 
                               placeholder="https://meet.google.com/... o https://zoom.us/... (opcional)" />
                        <div class="form-text small text-muted mt-1 d-inline-flex align-items-center gap-1">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            <span>Opcional. Si no ingresas un enlace, el turno se registrará sin enlace y el botón de acceso permanecerá inhabilitado.</span>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary-custom" @onclick="() => MostrarModalRecurrente = false">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">Generar Serie de Turnos</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Pop-up Cartel / Modal de Detalles y Cambio de Estado con Máxima Prioridad -->
@if (mostrarModalEstado && turnoSeleccionado != null)
{
    <div class="modal-overlay-priority" @onclick="CerrarModalEstado">
        <div class="modal-card-priority" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-medical text-primary fs-5" aria-hidden="true"></i>
                    <h5 class="m-0 font-bold text-dark">Detalles del Turno</h5>
                </div>
                <button type="button" class="btn-close" @onclick="CerrarModalEstado" title="Cerrar"></button>
            </div>

            <div class="mb-3">
                <div class="p-3 mb-3 bg-light rounded border">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="text-muted small">Paciente:</span>
                        <span class="font-bold text-dark">@GetNombrePaciente(turnoSeleccionado.IdPaciente)</span>
                    </div>

                    <div class="mb-2 pb-2 border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">
                                Fecha y Hora:
                                <button type="button" class="btn btn-sm btn-link p-0 text-primary ms-1 align-baseline" @onclick="ToggleEditarFechaHora" title="Editar fecha y hora">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                            </span>
                            @if (!editandoFechaHora)
                            {
                                <span class="font-semibold text-secondary">
                                    @editFecha.ToString("dd/MM/yyyy") - @editHora.ToString("HH:mm")
                                </span>
                            }
                        </div>
                        @if (editandoFechaHora)
                        {
                            <div class="row g-2 mt-2">
                                <div class="col-6">
                                    <label class="form-label font-semibold small mb-1">Fecha</label>
                                    <input type="date" 
                                           class="form-control form-control-sm" 
                                           min="@FechaMinimaPermitidaIso"
                                           @bind="editFecha" 
                                           @bind:format="yyyy-MM-dd" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label font-semibold small mb-1">Hora</label>
                                    <input type="text" 
                                           class="form-control form-control-sm" 
                                           list="lista-horas-24"
                                           placeholder="16:00"
                                           maxlength="5"
                                           @bind="HoraEditTexto" />
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mb-2 pb-2 border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">
                                Modalidad:
                                <button type="button" class="btn btn-sm btn-link p-0 text-primary ms-1 align-baseline" @onclick="ToggleEditarModalidad" title="Editar modalidad">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                            </span>
                            @if (!editandoModalidad)
                            {
                                <span class="badge @(editModalidad == ModalidadTurno.Online ? "badge-modalidad-online-sm" : "bg-light text-secondary border") d-inline-flex align-items-center gap-1">
                                    @if (editModalidad == ModalidadTurno.Online)
                                    {
                                        <i class="bi bi-camera-video" aria-hidden="true"></i> <span>Online</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-hospital" aria-hidden="true"></i> <span>Presencial</span>
                                    }
                                </span>
                            }
                        </div>
                        @if (editandoModalidad)
                        {
                            <div class="mt-1">
                                <select class="form-select form-select-sm" @bind="editModalidad">
                                    <option value="@ModalidadTurno.Presencial">Presencial</option>
                                    <option value="@ModalidadTurno.Online">Online</option>
                                </select>
                                @if (editModalidad == ModalidadTurno.Online)
                                {
                                    <input type="url" class="form-control form-control-sm mt-1" placeholder="Enlace de reunión virtual..." @bind="editEnlaceReunion" />
                                }
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="text-muted small">Estado actual:</span>
                        <span class="badge-estado @GetBadgeClass(turnoSeleccionado.Estado) d-inline-flex align-items-center gap-1">
                            @if (turnoSeleccionado.Estado == EstadoTurno.Activo)
                            {
                                <i class="bi bi-check-circle" aria-hidden="true"></i>
                            }
                            else if (turnoSeleccionado.Estado == EstadoTurno.Completo)
                            {
                                <i class="bi bi-check-all" aria-hidden="true"></i>
                            }
                            else if (turnoSeleccionado.Estado == EstadoTurno.Falta)
                            {
                                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                            }
                            else if (turnoSeleccionado.Estado == EstadoTurno.Cancelado)
                            {
                                <i class="bi bi-x-circle" aria-hidden="true"></i>
                            }
                            <span>@GetEstadoTextoConIcono(turnoSeleccionado.Estado)</span>
                        </span>
                    </div>

                    <!-- Observaciones con icono de lápiz para edición -->
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small font-semibold">
                                Observaciones:
                                <button type="button" class="btn btn-sm btn-link p-0 text-primary ms-1 align-baseline" @onclick="ToggleEditarObservacion" title="Editar observaciones">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                            </span>
                        </div>
                        @if (editandoObservacion)
                        {
                            <textarea class="form-control form-control-sm" rows="2" placeholder="Escriba las observaciones del turno..." @bind="editObservacion"></textarea>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(editObservacion))
                            {
                                <div class="p-2 bg-white rounded border small text-dark fst-italic">
                                    @editObservacion
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small fst-italic">
                                    Sin observaciones registradas para este turno.
                                </div>
                            }
                        }
                    </div>
                </div>

                <label class="form-label font-semibold mb-2">Seleccionar Estado:</label>
                <!-- Opciones interactivas de cambio de estado -->
                <div class="d-flex flex-column gap-1">
                    <button type="button" class="btn-state-item btn-state-activo @(estadoSeleccionado == EstadoTurno.Activo ? "state-current" : "")" @onclick="() => estadoSeleccionado = EstadoTurno.Activo">
                        <span class="state-icon-circle bg-activo d-inline-flex align-items-center justify-content-center">
                            <i class="bi bi-check-lg" aria-hidden="true"></i>
                        </span>
                        <span>Activo</span>
                        @if (estadoSeleccionado == EstadoTurno.Activo)
                        {
                            <span class="badge-current-mark ms-auto">Seleccionado</span>
                        }
                    </button>
                    <button type="button" class="btn-state-item btn-state-completo @(estadoSeleccionado == EstadoTurno.Completo ? "state-current" : "")" @onclick="() => estadoSeleccionado = EstadoTurno.Completo">
                        <span class="state-icon-circle bg-completo d-inline-flex align-items-center justify-content-center">
                            <i class="bi bi-check-all" aria-hidden="true"></i>
                        </span>
                        <span>Completo</span>
                        @if (estadoSeleccionado == EstadoTurno.Completo)
                        {
                            <span class="badge-current-mark ms-auto">Seleccionado</span>
                        }
                    </button>
                    <button type="button" class="btn-state-item btn-state-falta @(estadoSeleccionado == EstadoTurno.Falta ? "state-current" : "")" @onclick="() => estadoSeleccionado = EstadoTurno.Falta">
                        <span class="state-icon-circle bg-falta d-inline-flex align-items-center justify-content-center">
                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                        </span>
                        <span>Falta</span>
                        @if (estadoSeleccionado == EstadoTurno.Falta)
                        {
                            <span class="badge-current-mark ms-auto">Seleccionado</span>
                        }
                    </button>
                    <button type="button" class="btn-state-item btn-state-cancelado @(estadoSeleccionado == EstadoTurno.Cancelado ? "state-current" : "")" @onclick="() => estadoSeleccionado = EstadoTurno.Cancelado">
                        <span class="state-icon-circle bg-cancelado d-inline-flex align-items-center justify-content-center">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </span>
                        <span>Cancelado</span>
                        @if (estadoSeleccionado == EstadoTurno.Cancelado)
                        {
                            <span class="badge-current-mark ms-auto">Seleccionado</span>
                        }
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                <button type="button" class="btn btn-secondary-custom" @onclick="CerrarModalEstado">Cancelar</button>
                <button type="button" class="btn btn-primary-custom" @onclick="GuardarEstado">Guardar</button>
            </div>
        </div>
    </div>
}

