@page "/pacientes"
@attribute [Authorize(Roles = "Profesional,Administrativo,Operador")]

<div class="facturno-card">
    <div class="card-header-custom">
        <div>
            <h3 class="m-0 font-bold">👥 Gestor de Pacientes</h3>
            <p class="text-muted m-0">Administración de historias personales y cobertura de obras sociales</p>
        </div>
        <button class="btn btn-primary-custom" @onclick="AbrirModalNuevo">
            + Nuevo Paciente
        </button>
    </div>

    <!-- Buscador -->
    <div class="mb-4">
        <input type="text" class="form-control" placeholder="🔍 Buscar paciente por nombre, apellido o DNI..."
               @bind="FiltroBusqueda" @bind:event="oninput" />
    </div>

    @if (!string.IsNullOrWhiteSpace(MensajeAlerta))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @MensajeAlerta
            <button type="button" class="btn-close" @onclick="() => MensajeAlerta = null"></button>
        </div>
    }

    <!-- Tabla de Pacientes -->
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th># ID</th>
                    <th>Nombre Completo</th>
                    <th>Documento</th>
                    <th>Contacto</th>
                    <th>Obra Social</th>
                    <th>Nº Afiliado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pac in PacientesFiltrados)
                {
                    var nombreCompleto = pac.Persona != null ? $"{pac.Persona.Nombre} {pac.Persona.Apellido}" : "Sin nombre";
                    <tr>
                        <td><strong>#@pac.IdPaciente</strong></td>
                        <td>@nombreCompleto</td>
                        <td>@(pac.TipoDocumento?.ToString() ?? "DNI") @(pac.NumDocumento ?? "-")</td>
                        <td>
                            <div>📧 @(pac.Persona?.Correo ?? "-")</div>
                            <div>📞 @(pac.Persona?.Telefono?.ToString() ?? "-")</div>
                        </td>
                        <td><span class="badge bg-secondary">@(pac.ObraSocial?.Nombre ?? "Particular")</span></td>
                        <td>@(pac.NumObraSocial ?? "-")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarPaciente(pac)">
                                ✏️ Editar
                            </button>
                        </td>
                    </tr>
                }
                @if (!PacientesFiltrados.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            No se encontraron pacientes registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Nuevo / Editar Paciente -->
@if (MostrarModal)
{
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <h4 class="mb-3">@(EsEdicion ? "Editar Paciente" : "Registrar Nuevo Paciente")</h4>
            <EditForm Model="pacienteDto" OnValidSubmit="GuardarPaciente">
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Nombre *</label>
                        <InputText @bind-Value="pacienteDto.Nombre" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Apellido *</label>
                        <InputText @bind-Value="pacienteDto.Apellido" class="form-control" required />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Correo Electrónico</label>
                        <InputText @bind-Value="pacienteDto.Correo" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Teléfono</label>
                        <input type="number" class="form-control" @bind="pacienteDto.Telefono" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Tipo Documento</label>
                        <InputSelect @bind-Value="pacienteDto.TipoDocumento" class="form-select">
                            <option value="">Seleccionar...</option>
                            <option value="@TipoDocumento.DNI">DNI</option>
                            <option value="@TipoDocumento.CUIL">CUIL</option>
                            <option value="@TipoDocumento.Pasaporte">Pasaporte</option>
                        </InputSelect>
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Nº Documento</label>
                        <InputText @bind-Value="pacienteDto.NumDocumento" class="form-control" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Obra Social</label>
                        <select class="form-select" @bind="pacienteDto.IdObraSocial">
                            @foreach (var os in ListaObrasSociales)
                            {
                                <option value="@os.IdObraSocial">@os.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Nº Obra Social</label>
                        <InputText @bind-Value="pacienteDto.NumObraSocial" class="form-control" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary-custom" @onclick="() => MostrarModal = false">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">Guardar Paciente</button>
                </div>
            </EditForm>
        </div>
    </div>
}
