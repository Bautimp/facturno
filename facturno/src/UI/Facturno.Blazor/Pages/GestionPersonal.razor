@page "/gestion-personal"
@attribute [Authorize(Roles = "Operador,Administrativo")]

<div class="facturno-card">
    <div class="card-header-custom">
        <div>
            <h3 class="m-0 font-bold">🩺 Gestión de Personal Médico</h3>
            <p class="text-muted m-0">Administración de profesionales, especialidades, tarifas y vinculación de agendas</p>
        </div>
        <button class="btn btn-primary-custom" @onclick="AbrirModalNuevo">
            + Nuevo Profesional
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(MensajeAlerta))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @MensajeAlerta
            <button type="button" class="btn-close" @onclick="() => MensajeAlerta = null"></button>
        </div>
    }

    <!-- Tabla de Profesionales -->
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nombre Completo</th>
                    <th>Especialidad</th>
                    <th>Matrícula</th>
                    <th>CUIT</th>
                    <th>Precio Consulta</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prof in ListaProfesionales)
                {
                    var nombreCompleto = prof.Usuario?.Persona != null ? $"{prof.Usuario.Persona.Nombre} {prof.Usuario.Persona.Apellido}" : "Sin nombre";
                    var esActivo = prof.Usuario?.Activo ?? true;

                    <tr>
                        <td>
                            <strong>@nombreCompleto</strong>
                            <div class="text-muted small">📧 @(prof.Usuario?.Persona?.Correo ?? "-")</div>
                        </td>
                        <td><span class="badge bg-info text-dark">@(prof.Especialidad?.ToString() ?? "General")</span></td>
                        <td>@(prof.Matricula ?? "-")</td>
                        <td>@(prof.Cuit ?? "-")</td>
                        <td><strong>$ @(prof.PrecioConsulta?.ToString("N2") ?? "0.00")</strong></td>
                        <td>
                            <span class="badge @(esActivo ? "bg-success" : "bg-danger")">
                                @(esActivo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm @(esActivo ? "btn-outline-danger" : "btn-outline-success")"
                                    @onclick="() => ToggleEstadoActivo(prof, !esActivo)">
                                @(esActivo ? "Desactivar (Baja)" : "Activar")
                            </button>
                        </td>
                    </tr>
                }
                @if (!ListaProfesionales.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            No se encontraron profesionales registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Vinculación de Agendas Compartidas (Issue #14) -->
    <div class="border-top pt-4">
        <h5 class="font-bold mb-2">🤝 Vinculación de Agendas Compartidas (Issue #14)</h5>
        <p class="text-muted small mb-3">Conceder permisos a personal administrativo para gestionar la agenda del profesional.</p>

        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label font-semibold">Profesional</label>
                <select class="form-select" @bind="IdProfesionalVinculo">
                    <option value="@Guid.Empty">Seleccionar Profesional...</option>
                    @foreach (var prof in ListaProfesionales)
                    {
                        var nom = prof.Usuario?.Persona != null ? $"{prof.Usuario.Persona.Nombre} {prof.Usuario.Persona.Apellido}" : "Profesional";
                        <option value="@prof.IdProfesional">@nom</option>
                    }
                </select>
            </div>

            <div class="col-md-5">
                <label class="form-label font-semibold">ID Usuario Administrativo</label>
                <input type="text" class="form-control" placeholder="UUID del usuario administrativo..." @bind="IdAdministrativoVinculoStr" />
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-outline-primary w-100" @onclick="VincularAgenda">
                    Vincular
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nuevo Profesional -->
@if (MostrarModal)
{
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <h4 class="mb-3">Registrar Nuevo Profesional Médico</h4>
            <EditForm Model="profesionalDto" OnValidSubmit="GuardarProfesional">
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Nombre *</label>
                        <InputText @bind-Value="profesionalDto.Nombre" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Apellido *</label>
                        <InputText @bind-Value="profesionalDto.Apellido" class="form-control" required />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Correo Electrónico *</label>
                        <InputText @bind-Value="profesionalDto.Correo" type="email" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Contraseña Inicial *</label>
                        <InputText @bind-Value="profesionalDto.Password" type="password" class="form-control" required />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Especialidad</label>
                        <InputSelect @bind-Value="profesionalDto.Especialidad" class="form-select">
                            <option value="">Seleccionar...</option>
                            <option value="@TipoEspecialidad.Psicologo">Psicólogo</option>
                            <option value="@TipoEspecialidad.Psiquiatra">Psiquiatra</option>
                            <option value="@TipoEspecialidad.Otro">Otro</option>
                        </InputSelect>
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Matrícula</label>
                        <InputText @bind-Value="profesionalDto.Matricula" class="form-control" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">CUIT</label>
                        <InputText @bind-Value="profesionalDto.Cuit" class="form-control" placeholder="20-12345678-9" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Precio Consulta ($)</label>
                        <input type="number" step="0.01" class="form-control" @bind="profesionalDto.PrecioConsulta" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary-custom" @onclick="() => MostrarModal = false">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">Guardar Profesional</button>
                </div>
            </EditForm>
        </div>
    </div>
}
