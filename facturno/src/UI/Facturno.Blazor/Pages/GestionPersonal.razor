@page "/gestion-personal"
@attribute [Authorize(Roles = "Operador,Administrativo,Profesional")]

<SystemPopupMessage Message="@MensajeAlerta" OnClose="() => MensajeAlerta = null" />

<div class="facturno-card" style="position: relative;">
    <LoadingOverlay IsLoading="IsLoading" Text="Cargando información..." />
    
    <div class="card-header-custom mb-3">
        <div>
            <h3 class="m-0 font-bold">Gestión de Personal & Obras Sociales</h3>
            <p class="text-muted m-0">Administración de profesionales, especialidades, agendas compartidas y convenios con Obras Sociales</p>
        </div>
        <div class="d-flex gap-2">
            @if (TabActiva == "personal")
            {
                @if (EsOperador)
                {
                    <button class="btn btn-outline-primary" @onclick="AbrirModalNuevoAdmin">
                        + Nuevo Administrativo
                    </button>
                    <button class="btn btn-primary-custom" @onclick="AbrirModalNuevo">
                        + Nuevo Profesional
                    </button>
                }
            }
            else
            {
                @if (EsOperador)
                {
                    <button class="btn btn-primary-custom" @onclick="AbrirModalNuevaObraSocial">
                        + Nueva Obra Social
                    </button>
                }
            }
        </div>
    </div>

    <!-- Pestañas de Navegación -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <button class="nav-link @(TabActiva == "personal" ? "active fw-bold border-bottom-0 text-primary" : "text-secondary")" 
                    style="cursor: pointer;"
                    @onclick='() => TabActiva = "personal"'>
                <i class="bi bi-person-badge me-1" aria-hidden="true"></i> Personal Médico
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(TabActiva == "obrassociales" ? "active fw-bold border-bottom-0 text-primary" : "text-secondary")" 
                    style="cursor: pointer;"
                    @onclick='() => TabActiva = "obrassociales"'>
                <i class="bi bi-hospital me-1" aria-hidden="true"></i> Obras Sociales
            </button>
        </li>
    </ul>

    @if (TabActiva == "personal")
    {
        <!-- Tabla de Profesionales con Paginación y Grillas Bootstrap -->
        <div class="table-responsive mb-2">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nombre Completo</th>
                        <th>Especialidad</th>
                        <th>Matrícula</th>
                        <th>CUIT</th>
                        <th>Precio Consulta</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prof in ProfesionalesPaginados)
                    {
                        var nombreCompleto = prof.Usuario?.Persona != null ? $"{prof.Usuario.Persona.Nombre} {prof.Usuario.Persona.Apellido}" : "Sin nombre";
                        var esActivo = prof.Usuario?.Activo ?? true;

                        <tr>
                            <td>
                                <strong>@nombreCompleto</strong>
                                <div class="text-muted small">@(prof.Usuario?.Persona?.Correo ?? "-")</div>
                            </td>
                            <td><span class="badge bg-info text-dark">@(prof.Especialidad?.ToString() ?? "General")</span></td>
                            <td>@(prof.Matricula ?? "-")</td>
                            <td>@(prof.Cuit ?? "-")</td>
                            <td><strong>$ @(prof.PrecioConsulta?.ToString("N2") ?? "0.00")</strong></td>
                            <td>
                                <span class="badge @(esActivo ? "bg-success" : "bg-danger")">
                                    @(esActivo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-2 d-inline-flex align-items-center" @onclick="() => AbrirModalEditar(prof)">
                                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Editar
                                </button>
                                <button class="btn btn-sm @(esActivo ? "btn-outline-danger" : "btn-outline-success")"
                                        @onclick="() => ToggleEstadoActivo(prof, !esActivo)">
                                    @(esActivo ? "Desactivar (Baja)" : "Activar")
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!ProfesionalesPaginados.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No se encontraron profesionales registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ListaProfesionales.Any())
        {
            <div class="row align-items-center mb-4 g-2">
                <div class="col-md-6 text-muted small text-center text-md-start">
                    Mostrando @(((PaginaPersonal - 1) * ElementosPorPaginaPersonal) + 1) - @Math.Min(PaginaPersonal * ElementosPorPaginaPersonal, ListaProfesionales.Count) de @ListaProfesionales.Count profesionales
                </div>
                <div class="col-md-6 d-flex justify-content-center justify-content-md-end">
                    <nav aria-label="Paginación de profesionales">
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item @(PaginaPersonal <= 1 ? "disabled" : "")">
                                <button type="button" class="page-link" @onclick="() => CambiarPaginaPersonal(PaginaPersonal - 1)">« Anterior</button>
                            </li>
                            @for (int p = 1; p <= TotalPaginasPersonal; p++)
                            {
                                var pageNum = p;
                                <li class="page-item @(pageNum == PaginaPersonal ? "active" : "")">
                                    <button type="button" class="page-link" @onclick="() => CambiarPaginaPersonal(pageNum)">@pageNum</button>
                                </li>
                            }
                            <li class="page-item @(PaginaPersonal >= TotalPaginasPersonal ? "disabled" : "")">
                                <button type="button" class="page-link" @onclick="() => CambiarPaginaPersonal(PaginaPersonal + 1)">Siguiente »</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }

        <!-- Vinculación de Agendas Compartidas -->
        <div class="border-top pt-4">
            <h5 class="font-bold mb-2">
                <i class="bi bi-link-45deg me-1" aria-hidden="true"></i> Vinculación de Agendas Compartidas
            </h5>
            <p class="text-muted small mb-3">Conceder o revocar permisos a personal administrativo para gestionar agendas médicas.</p>

            @if (EsOperador || EsProfesional)
            {
                <div class="row g-3 mb-4 p-3 bg-light rounded border">
                    <div class="col-md-5">
                        <label class="form-label font-semibold">Profesional Médico</label>
                        @if (EsProfesional && !EsOperador)
                        {
                            var miNombre = ListaProfesionales.FirstOrDefault(p => p.IdProfesional == IdProfesionalActual)?.Usuario?.Persona;
                            <input type="text" class="form-control bg-white" value="@(miNombre != null ? $"{miNombre.Nombre} {miNombre.Apellido} (Mi Agenda)" : "Mi Agenda")" readonly disabled />
                        }
                        else
                        {
                            <select class="form-select" @bind="IdProfesionalVinculo">
                                <option value="@Guid.Empty">Seleccionar Profesional...</option>
                                @foreach (var prof in ListaProfesionales)
                                {
                                    var nom = prof.Usuario?.Persona != null ? $"{prof.Usuario.Persona.Nombre} {prof.Usuario.Persona.Apellido}" : "Profesional";
                                    <option value="@prof.IdProfesional">@nom</option>
                                }
                            </select>
                        }
                    </div>

                    <div class="col-md-5">
                        <label class="form-label font-semibold">Personal Administrativo</label>
                        <select class="form-select" @bind="IdAdministrativoVinculoStr">
                            <option value="">Seleccionar Administrativo...</option>
                            @foreach (var admin in ListaAdministrativos)
                            {
                                var nomAdmin = admin.Persona != null ? $"{admin.Persona.Nombre} {admin.Persona.Apellido} ({admin.Rol})" : $"Usuario {admin.IdUsuario}";
                                <option value="@admin.IdUsuario">@nomAdmin</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-outline-primary w-100 d-inline-flex align-items-center justify-content-center gap-1" @onclick="VincularAgenda">
                            <i class="bi bi-link" aria-hidden="true"></i>
                            <span>Vincular</span>
                        </button>
                    </div>
                </div>
            }

            <!-- Listado de Vinculaciones Activas -->
            <div class="mt-3">
                <h6 class="font-semibold text-secondary mb-2">Vínculos de Agenda Registrados:</h6>
                @if (ListaVinculosAgendas.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered bg-white align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Profesional Médico</th>
                                    <th>Administrativo Autorizado</th>
                                    <th>Fecha Vinculación</th>
                                    <th class="text-end" style="width: 150px;">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vinculo in ListaVinculosAgendas)
                                {
                                    <tr>
                                        <td>
                                            <i class="bi bi-person-badge text-primary me-1" aria-hidden="true"></i>
                                            <strong>@vinculo.ProfesionalNombre</strong>
                                        </td>
                                        <td>
                                            <i class="bi bi-person-gear text-secondary me-1" aria-hidden="true"></i>
                                            @vinculo.AdministrativoNombre
                                        </td>
                                        <td class="text-muted small">
                                            @(vinculo.CreatedAt != default ? vinculo.CreatedAt.ToString("dd/MM/yyyy HH:mm") : "-")
                                        </td>
                                        <td class="text-end">
                                            @if (EsOperador || (EsProfesional && vinculo.IdProfesional == IdProfesionalActual))
                                            {
                                                <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" @onclick="() => DesvincularAgenda(vinculo.Id)" title="Desvincular administrativo de esta agenda">
                                                    <i class="bi bi-link-45deg" aria-hidden="true"></i>
                                                    <span>Desvincular</span>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-3 bg-light rounded border text-muted small text-center">
                        <i class="bi bi-info-circle me-1" aria-hidden="true"></i> No hay agendas compartidas vinculadas actualmente.
                    </div>
                }
            </div>
        </div>
    }
    else if (TabActiva == "obrassociales")
    {
        <!-- Pestaña Obras Sociales -->
        <div class="row mb-3 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search" aria-hidden="true"></i></span>
                    <input type="text" class="form-control" placeholder="Buscar Obra Social por nombre..." value="@FiltroObraSocial" @oninput="OnFiltroObraSocialInput" />
                </div>
            </div>
            <div class="col-md-6 text-end text-muted small">
                Total obras sociales: <strong>@ObrasSocialesFiltradas.Count()</strong>
            </div>
        </div>

        <div class="table-responsive mb-2">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Nombre / Denominación</th>
                        <th>Fecha Registro</th>
                        <th style="width: 120px;">Estado</th>
                        <th class="text-end" style="width: 220px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var os in ObrasSocialesPaginadas)
                    {
                        <tr>
                            <td><code>#@os.IdObraSocial</code></td>
                            <td>
                                <strong>@os.Nombre</strong>
                            </td>
                            <td>@(os.CreatedAt != default ? os.CreatedAt.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                            <td>
                                <span class="badge @(os.Activo ? "bg-success" : "bg-danger")">
                                    @(os.Activo ? "Activo" : "Dado de Baja")
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-2 d-inline-flex align-items-center" @onclick="() => AbrirModalEditarObraSocial(os)">
                                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Editar
                                </button>
                                <button class="btn btn-sm @(os.Activo ? "btn-outline-danger" : "btn-outline-success")"
                                        @onclick="() => ToggleEstadoObraSocial(os, !os.Activo)">
                                    @(os.Activo ? "Dar de Baja" : "Activar")
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!ObrasSocialesPaginadas.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No se encontraron obras sociales registradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ObrasSocialesFiltradas.Any())
        {
            <div class="row align-items-center mb-3 g-2">
                <div class="col-md-6 text-muted small text-center text-md-start">
                    Mostrando @(((PaginaObraSocial - 1) * ElementosPorPaginaObraSocial) + 1) - @Math.Min(PaginaObraSocial * ElementosPorPaginaObraSocial, ObrasSocialesFiltradas.Count()) de @ObrasSocialesFiltradas.Count() obras sociales
                </div>
                <div class="col-md-6 d-flex justify-content-center justify-content-md-end">
                    <nav aria-label="Paginación de obras sociales">
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item @(PaginaObraSocial <= 1 ? "disabled" : "")">
                                <button type="button" class="page-link" @onclick="() => CambiarPaginaObraSocial(PaginaObraSocial - 1)">« Anterior</button>
                            </li>
                            @for (int p = 1; p <= TotalPaginasObraSocial; p++)
                            {
                                var pageNum = p;
                                <li class="page-item @(pageNum == PaginaObraSocial ? "active" : "")">
                                    <button type="button" class="page-link" @onclick="() => CambiarPaginaObraSocial(pageNum)">@pageNum</button>
                                </li>
                            }
                            <li class="page-item @(PaginaObraSocial >= TotalPaginasObraSocial ? "disabled" : "")">
                                <button type="button" class="page-link" @onclick="() => CambiarPaginaObraSocial(PaginaObraSocial + 1)">Siguiente »</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }
    }
</div>

<!-- Modal Nuevo Profesional -->
@if (MostrarModal)
{
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <h4 class="mb-3 font-bold">Registrar Nuevo Profesional Médico</h4>
            <EditForm Model="profesionalDto" OnValidSubmit="GuardarProfesional">
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Nombre *</label>
                        <InputText @bind-Value="profesionalDto.Nombre" class="form-control" placeholder="ej: Lucas" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Apellido *</label>
                        <InputText @bind-Value="profesionalDto.Apellido" class="form-control" placeholder="ej: Gómez" required />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Correo Electrónico *</label>
                        <InputText @bind-Value="profesionalDto.Correo" type="email" class="form-control" placeholder="medico@facturno.com" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Contraseña Inicial *</label>
                        <InputText @bind-Value="profesionalDto.Password" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Teléfono</label>
                        <input type="number" class="form-control" @bind="profesionalDto.Telefono" placeholder="ej: 1123456789" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Especialidad</label>
                        <InputSelect @bind-Value="profesionalDto.Especialidad" class="form-select">
                            <option value="">Seleccionar...</option>
                            <option value="@TipoEspecialidad.Psicologo">Psicólogo</option>
                            <option value="@TipoEspecialidad.Psiquiatra">Psiquiatra</option>
                            <option value="@TipoEspecialidad.Otro">Otro</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Matrícula</label>
                        <InputText @bind-Value="profesionalDto.Matricula" class="form-control" placeholder="ej: MP-12345" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">CUIT</label>
                        <InputText @bind-Value="profesionalDto.Cuit" class="form-control" placeholder="20-12345678-9" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Precio Consulta ($)</label>
                        <input type="number" step="0.01" class="form-control" @bind="profesionalDto.PrecioConsulta" placeholder="0.00" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary-custom" @onclick="() => MostrarModal = false">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">Guardar Profesional</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal Nuevo Administrativo -->
@if (MostrarModalAdmin)
{
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <h4 class="mb-3 font-bold">Registrar Usuario Administrativo</h4>
            <EditForm Model="adminDto" OnValidSubmit="GuardarAdministrativo">
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Nombre *</label>
                        <InputText @bind-Value="adminDto.Nombre" class="form-control" placeholder="ej: María" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Apellido *</label>
                        <InputText @bind-Value="adminDto.Apellido" class="form-control" placeholder="ej: Fernández" required />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Correo Electrónico *</label>
                        <InputText @bind-Value="adminDto.Correo" type="email" class="form-control" placeholder="admin@facturno.com" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Contraseña Inicial *</label>
                        <InputText @bind-Value="adminDto.Password" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label font-semibold">Teléfono</label>
                    <input type="number" class="form-control" @bind="adminDto.Telefono" placeholder="ej: 1123456789" />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary-custom" @onclick="() => MostrarModalAdmin = false">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">Guardar Administrativo</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal Editar Profesional -->
@if (MostrarModalEditar)
{
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <h4 class="mb-3 font-bold">Modificar Datos del Profesional Médico</h4>
            <EditForm Model="profesionalEditarDto" OnValidSubmit="ActualizarProfesional">
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Nombre *</label>
                        <InputText @bind-Value="profesionalEditarDto.Nombre" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Apellido *</label>
                        <InputText @bind-Value="profesionalEditarDto.Apellido" class="form-control" required />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Correo Electrónico</label>
                        <InputText @bind-Value="profesionalEditarDto.Correo" type="email" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Teléfono</label>
                        <input type="number" class="form-control" @bind="profesionalEditarDto.Telefono" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">Especialidad</label>
                        <InputSelect @bind-Value="profesionalEditarDto.Especialidad" class="form-select">
                            <option value="">Seleccionar...</option>
                            <option value="@TipoEspecialidad.Psicologo">Psicólogo</option>
                            <option value="@TipoEspecialidad.Psiquiatra">Psiquiatra</option>
                            <option value="@TipoEspecialidad.Otro">Otro</option>
                        </InputSelect>
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Matrícula</label>
                        <InputText @bind-Value="profesionalEditarDto.Matricula" class="form-control" placeholder="ej: MP-12345" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label font-semibold">CUIT</label>
                        <InputText @bind-Value="profesionalEditarDto.Cuit" class="form-control" placeholder="20-12345678-9" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-semibold">Precio Consulta ($)</label>
                        <input type="number" step="0.01" class="form-control" @bind="profesionalEditarDto.PrecioConsulta" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary-custom" @onclick="() => MostrarModalEditar = false">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">Guardar Cambios</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal Nueva / Editar Obra Social -->
@if (MostrarModalObraSocial)
{
    <div class="modal-overlay">
        <div class="modal-content-custom">
            <h4 class="mb-3 font-bold">@(EsEdicionObraSocial ? "Modificar Obra Social" : "Registrar Obra Social")</h4>
            <EditForm Model="ObraSocialModelo" OnValidSubmit="GuardarObraSocial">
                <div class="mb-3">
                    <label class="form-label font-semibold">Nombre de la Obra Social / Prepaga *</label>
                    <InputText @bind-Value="ObraSocialModelo.Nombre" class="form-control" placeholder="ej: OSDE, Swiss Medical, Galeno..." required />
                    <div class="form-text small text-muted">2 a 60 caracteres alfanuméricos válidos.</div>
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="ObraSocialModelo.Activo" class="form-check-input" id="osActivoCheck" />
                    <label class="form-check-label font-semibold" for="osActivoCheck">
                        Obra Social Activa (Habilitada para atención de pacientes)
                    </label>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary-custom" @onclick="() => MostrarModalObraSocial = false">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">@(EsEdicionObraSocial ? "Actualizar" : "Guardar")</button>
                </div>
            </EditForm>
        </div>
    </div>
}
