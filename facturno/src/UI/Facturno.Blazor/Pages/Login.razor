@page "/"
@page "/login"
@layout EmptyLayout

<div class="login-bg">
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="mb-2">
                <i class="bi bi-hospital text-primary fs-1" aria-hidden="true"></i>
            </div>
            <h2 class="font-bold text-primary mb-1 tracking-tight">FACTURNO</h2>
            <p class="text-muted small mb-0 font-medium">Centro Médico Buen Pastor</p>
            <p class="text-secondary small">Portal de Gestión Asistencial y Turnos</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger font-medium mb-3 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-octagon-fill flex-shrink-0" aria-hidden="true"></i>
                <div class="small">@ErrorMessage</div>
            </div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label font-semibold small">Correo Electrónico</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                    </span>
                    <InputText @bind-Value="loginModel.Correo" 
                               @onblur="NormalizarCorreo" 
                               class="form-control" 
                               placeholder="usuario@buenpastor.com" 
                               required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label font-semibold small">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                    </span>
                    <input type="@(mostrarPassword ? "text" : "password")" 
                           class="form-control" 
                           placeholder="••••••••" 
                           value="@loginModel.Password"
                           @onchange="(e) => loginModel.Password = e.Value?.ToString() ?? string.Empty"
                           required />
                    <button type="button" 
                            class="btn btn-outline-secondary" 
                            @onclick="ToggleMostrarPassword" 
                            tabindex="-1"
                            title="@(mostrarPassword ? "Ocultar contraseña" : "Ver contraseña")">
                        <i class="bi @(mostrarPassword ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 mb-2 py-2 font-semibold" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Accediendo al sistema...</span>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>
                    <span>Iniciar Sesión</span>
                }
            </button>
        </EditForm>
    </div>
</div>
