@inherits LayoutComponentBase

<div class="app-layout-top">
    <AuthorizeView>
        <Authorized>
            <header class="top-navbar-header shadow-sm">
                <div class="navbar-left-section">
                    <div class="top-brand">
                        <i class="bi bi-hospital fs-4 text-primary" aria-hidden="true"></i>
                        <span class="brand-title-top">Facturno</span>
                        <span class="brand-divider"></span>
                        <span class="brand-clinic-name">Centro Médico Buen Pastor</span>
                    </div>

                    <nav class="top-navigation-menu">
                        <NavMenu />
                    </nav>
                </div>

                <div class="navbar-right-section">
                    <div class="user-info-pill">
                        <div class="user-avatar-circle">
                            @GetUserInitials(context.User)
                        </div>
                        <div class="user-meta d-none d-md-flex">
                            <span class="user-name">@context.User.Identity?.Name</span>
                            <span class="badge role-badge">@GetUserRole(context.User)</span>
                        </div>
                    </div>
                    <button class="btn btn-outline-danger btn-sm rounded-pill px-3 btn-logout d-inline-flex align-items-center gap-1" @onclick="ConfirmarYDesloguear" title="Cerrar sesión actual">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        <span>Cerrar Sesión</span>
                    </button>
                </div>
            </header>

            <main class="top-main-content">
                @Body
            </main>
        </Authorized>

        <NotAuthorized>
            <div class="w-100">
                @Body
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>
