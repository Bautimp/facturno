<ul class="top-nav-list">
    <li class="nav-item top-nav-item">
        <NavLink class="top-nav-link" href="agenda" Match="NavLinkMatch.Prefix">
            <i class="bi bi-calendar3 nav-icon me-1" aria-hidden="true"></i>
            <span class="d-none d-md-inline">Agenda y Turnos</span>
            <span class="d-inline d-md-none">Agenda</span>
        </NavLink>
    </li>
    <li class="nav-item top-nav-item">
        <NavLink class="top-nav-link" href="pacientes" Match="NavLinkMatch.Prefix">
            <i class="bi bi-people nav-icon me-1" aria-hidden="true"></i>
            <span>Pacientes</span>
        </NavLink>
    </li>
    
    <AuthorizeView Roles="Operador,Administrativo,Profesional">
        <Authorized>
            <li class="nav-item top-nav-item">
                <NavLink class="top-nav-link" href="gestion-personal" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-gear nav-icon me-1" aria-hidden="true"></i>
                    @if (context.User.IsInRole("Profesional"))
                    {
                        <span class="d-none d-md-inline">Mis Datos & Obras Soc.</span>
                        <span class="d-inline d-md-none">Mis Datos</span>
                    }
                    else
                    {
                        <span class="d-none d-md-inline">Gestión de Personal</span>
                        <span class="d-inline d-md-none">Personal</span>
                    }
                </NavLink>
            </li>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Operador">
        <Authorized>
            <li class="nav-item top-nav-item">
                <NavLink class="top-nav-link" href="configuracion" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-sliders nav-icon me-1" aria-hidden="true"></i>
                    <span class="d-none d-md-inline">Configuración</span>
                    <span class="d-inline d-md-none">Config</span>
                </NavLink>
            </li>
        </Authorized>
    </AuthorizeView>
</ul>
